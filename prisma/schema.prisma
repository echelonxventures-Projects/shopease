// ===================== BNPL (BUY NOW PAY LATER) =====================

model BNPLOrder {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  provider        String   // ZIP, Simpl, LazyPay, etc.
  totalAmount     Decimal
  downPayment     Decimal  @default(0)
  numberOfInstallments Int   @default(4)
  installmentAmount Decimal
  nextInstallmentDate DateTime
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | DEFAULTED
  createdAt       DateTime @default(now())

  installments    BNPLInstallment[]
  @@index([orderId])
  @@map("bnpl_orders")
}

model BNPLInstallment {
  id              String   @id @default(cuid())
  bnplOrderId     String
  bnplOrder       BNPLOrder @relation(fields: [bnplOrderId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount          Decimal
  dueDate         DateTime
  paidAt          DateTime?
  status          String   @default("PENDING") // PENDING | PAID | OVERDUE
  createdAt       DateTime @default(now())

  @@index([bnplOrderId, status])
  @@map("bnpl_installments")
}

// ===================== SPLIT PAYMENT =====================

model SplitPayment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  walletAmount Decimal  @default(0)
  cardAmount  Decimal  @default(0)
  upiAmount   Decimal  @default(0)
  codAmount   Decimal  @default(0)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("split_payments")
}

// ===================== BUNDLE DEALS =====================

model BundleDeal {
  id           String   @id @default(cuid())
  name         String
  description  String?
  bannerImage  String?
  discountType String   @default("PERCENTAGE")
  discountValue Decimal
  maxDiscount  Decimal?
  minItems     Int      @default(2)
  isActive     Boolean  @default(true)
  validFrom    DateTime?
  validUntil   DateTime?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  items        BundleDealItem[]
  @@index([isActive])
  @@map("bundle_deals")
}

model BundleDealItem {
  id          String   @id @default(cuid())
  bundleId    String
  bundle      BundleDeal @relation(fields: [bundleId], references: [id], onDelete: Cascade)
