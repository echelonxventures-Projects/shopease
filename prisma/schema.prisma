// ===================== AI CHATBOT =====================

model ChatbotSession {
  id         String   @id @default(cuid())
  userId     String?
  messages   Json[]   @default([])
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, startedAt])
}

// ===================== AI/ML PLATFORM =====================

model AIConfig {
  id        String   @id @default(cuid())
  feature   String   @unique
  enabled   Boolean  @default(false)
  provider  String   @default("groq")
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model UserBehavior {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String
  type       String
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, type, createdAt])
  @@index([sessionId, type, createdAt])
  @@index([productId, type])
}

model AIRecommendation {
  id        String   @id @default(cuid())
  userId    String?
  productId String?
  strategy  String
  score     Float
  metadata  Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, strategy])
  @@index([productId, strategy])
}

model VoiceSearchLog {
  id            String   @id @default(cuid())
  userId        String?
  transcript    String
  confidence    Float
  locale        String
  correctedText String?
  searchResults String?
  hadResults    Boolean?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model VoicePattern {
  id             String   @id @default(cuid())
  phonemeGroup   String
  commonProduct  String
  correctionRate Float    @default(0)
  usageCount     Int      @default(0)
  lastCorrected  DateTime?
  createdAt      DateTime @default(now())

  @@unique([phonemeGroup, commonProduct])
}

model VideoAnalysis {
  id               String   @id @default(cuid())
  userId           String?
  videoUrl         String
  status           String   @default("PENDING")
  frames           Json?
  detectedProducts Json?
  metadata         Json?
  processingTimeMs Int?
  createdAt        DateTime @default(now())
  completedAt      DateTime?
}

model FraudScore {
  id         String   @id @default(cuid())
  userId     String?
  orderId    String?
  type       String
  score      Float
  factors    Json?
  action     String   @default("REVIEW")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, type])
  @@index([score])
  @@index([action, createdAt])
  @@index([orderId])
}

model ChurnPrediction {
  id                 String   @id @default(cuid())
  userId             String   @unique
  score              Float
  riskLevel          String
  factors            Json?
  predictedChurnDate DateTime?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([riskLevel])
  @@index([score])
}

model CustomerSegment {
  id        String   @id @default(cuid())
  userId    String
  segment   String
  confidence Float
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([userId, segment])
  @@index([segment])
}

model AIAgent {
  id         String   @id @default(cuid())
  name       String   @unique
  description String?
  type       String
  status     String   @default("ACTIVE")
  config     Json
  lastRunAt  DateTime?
  lastStatus String?
  errorCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  runs       AgentRun[]
}

model AgentRun {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  status      String   @default("RUNNING")
  input       Json?
  output      Json?
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([agentId, createdAt])
}

model PricingPrediction {
  id                   String   @id @default(cuid())
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  currentPrice         Float
  predictedOptimalPrice Float
  confidence           Float
  demandForecast       Float
  competitorAvg        Float?
  elasticity           Float
  suggestedAction      String
  metadata             Json?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([productId, expiresAt])
}

model DemandForecast {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  forecastDate   DateTime
  predictedDemand Int
  confidence     Float
  seasonality    Float?
  trend          Float?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([productId, forecastDate])
}

model NextBestAction {
  id          String    @id @default(cuid())
  userId      String
  action      String
  productId   String?
  score       Float
  reason      String?
  delivered   Boolean   @default(false)
  deliveredAt DateTime?
  converted   Boolean?
  createdAt   DateTime  @default(now())

  @@index([userId, delivered, converted])
}

// ===================== TAX SYNC =====================

model TaxSyncLog {
  id          String   @id @default(cuid())
  countryCode String
  source      String   // URL or notification reference
  rulesCount  Int
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED
  error       String?
  syncedAt    DateTime @default(now())

  @@index([countryCode, syncedAt])
  @@map("tax_sync_logs")
}

// ===================== MULTI-SITE / MULTI-TENANT =====================

model Site {
  id            String     @id @default(cuid())
  name          String                        // "Tenant 1 Store"
  slug          String     @unique             // "tenant1"
  domain        String?    @unique             // "shop.tenant1.com" (custom domain)
  subdomain     String?    @unique             // "tenant1" (subdomain part)
  status        SiteStatus @default(PENDING)   // PENDING | ACTIVE | SUSPENDED
  isDefault     Boolean    @default(false)     // fallback site (current platform)

  // ── Recursive White-Label SaaS ─────────────────────────────────────────────
  // Each site can sell sub-sites (infinite depth). A child site inherits from parent.
  parentSiteId   String?
  parentSite     Site?      @relation("SiteHierarchy", fields: [parentSiteId], references: [id])
  childSites     Site[]     @relation("SiteHierarchy")
  tier           Int        @default(0)        // 0 = root platform, 1 = first reseller, 2 = sub-reseller, etc.

  // What type of platform this site runs (can be multiple)
  platformTypes  String[]   @default([])       // ["ecommerce", "streaming", "trading", "lms", "saas", ...]
  // Infinite configurable options per platform type
  platformOptions Json?     // { "streaming": {"maxPlans": 5, "allowLive": true}, "ecommerce": {"maxProducts": 1000} }

  // Per-site analytics & tracking config
  analyticsConfig Json?     // { "ga4": "G-XXX", "mixpanel": "xxx", "custom": {...} }

  // Can this site resell/provision child sites?
  canResell      Boolean    @default(false)
  // Which platform types can this site sell to children?
  resellableTypes String[]  @default([])       // ["ecommerce", "streaming", "trading"]
  // Max child sites this site can provision (-1 = unlimited)
  maxChildSites  Int        @default(-1)

  // Branding
  logo           String?
  favicon        String?
  primaryColor   String     @default("#2563eb")
  secondaryColor String     @default("#f59e0b")
  fontFamily     String     @default("sans")
  theme          Json?

  // Region & Localization
  regionId         String?
  region           Region?    @relation(fields: [regionId], references: [id])
  defaultCurrency  String?
  defaultLocale    String?
  supportedLocales String[]   @default([])

  // Contact / ownership
  contactEmail   String?
  contactPhone   String?
  contactAddress String?

  // Settings
  settings       Json?    // {taxInclusive, currency, timezone, maintenanceMode}
  description    String?
  metaTitle      String?
  metaDescription String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  products       SiteProduct[]
  categories     SiteCategory[]
  brands         SiteBrand[]
  banners        SiteBanner[]
  menus          SiteMenu[]
  pages          SitePage[]
  domains        SiteDomain[]
  siteAdmins     SiteAdmin[]
  paymentGateways PaymentGatewaySite[]
  sitePlans      SitePlan[]     @relation("SiteSellsPlans")
  subscription   SitePlan?      @relation("SiteSubscribedPlan", fields: [subscribedPlanId], references: [id])
  subscribedPlanId String?

  // FK to existing data
  orders         Order[]
  users          User[]
  carts          CartItem[]
  reviews        Review[]
  wishlists      WishlistItem[]
  bannersLegacy  Banner[]  @relation("SiteBanners")

  @@index([slug])
  @@index([status])
  @@index([isDefault])
  @@index([regionId])
  @@index([parentSiteId])
  @@index([tier])
  @@map("sites")
}

// ── Site Plans: Sellable platform subscriptions with infinite options ─────────
// Each site that canResell defines plans that child sites subscribe to.
model SitePlan {
  id              String   @id @default(cuid())
  siteId          String                       // The site selling this plan
  site            Site     @relation("SiteSellsPlans", fields: [siteId], references: [id], onDelete: Cascade)
  name            String                       // "Starter Ecommerce", "Pro Streaming"
  slug            String
  description     String?
  platformType    String                       // "ecommerce", "streaming", "trading", etc.
  price           Float
  currency        String   @default("INR")
  interval        String   @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY, LIFETIME
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  trialDays       Int      @default(0)

  // Infinite configurable options — anything the seller wants to offer
  options         Json?    // {"maxProducts": 500, "customDomain": true, "maxUsers": 10, "storage": "50GB", "support": "24/7", ...}
  // What features/modules are included
  includedModules String[] @default([])        // ["ecommerce", "analytics", "email"]
  // Limits for the child site
  limits          Json?    // {"maxOrders": 1000, "maxBandwidth": "100GB", "maxChildSites": 5, ...}

  // Sites subscribed to this plan
  subscribers     Site[]   @relation("SiteSubscribedPlan")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, isActive, sortOrder])
  @@index([platformType])
  @@map("site_plans")
}

// ── MLM Revenue Share: Multi-level hierarchical revenue distribution ─────────
// Each site defines what % it takes from child revenue, and how deep the chain goes.
// Revenue flows upward: child pays parent, parent pays grandparent, etc.
model RevenueShareConfig {
  id              String   @id @default(cuid())
  siteId          String   @unique  // The site that configures this
  enabled         Boolean  @default(true)
  maxDepth        Int      @default(-1)  // -1 = unlimited levels
  // Per-level percentages (index 0 = direct parent, 1 = grandparent, etc.)
  // If levels exceed array length, last value repeats forever (for unlimited depth)
  levelPercentages Float[] @default([20, 10, 5, 2, 1])
  repeatLastLevel  Boolean @default(true) // If true, last % repeats for all deeper levels
  // Override rules per platform type — supports infinite types
  // { "streaming": [25, 12, 6], "trading": [15, 8, 3], "lms": [30, 15], "custom_xyz": [10, 5] }
  platformOverrides Json?
  // Revenue types that trigger sharing — infinite configurable types
  // ["order", "subscription", "ad_revenue", "commission", "tip", "donation", "license", "api_usage", ...]
  revenueTypes     String[] @default(["order", "subscription"])
  // Per revenue-type percentage overrides
  // { "subscription": [30, 15, 7], "ad_revenue": [10, 5, 2], "tip": [5, 2] }
  revenueTypeOverrides Json?
  // ── Payout Configuration (fully configurable) ──────────────────────────────
  minPayout       Float    @default(100)
  currency        String   @default("INR")
  payoutInterval  String   @default("MONTHLY") // DAILY, WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, ON_DEMAND, INSTANT
  payoutMethods   String[] @default(["bank_transfer", "wallet", "upi"]) // Infinite payout methods
  autoApprove     Boolean  @default(false)  // Auto-approve payouts below threshold
  autoApproveMax  Float    @default(10000)  // Auto-approve up to this amount
  holdDays        Int      @default(7)      // Hold period before payout eligible
  // ── Bonus & Incentive Rules (infinite configurable) ────────────────────────
  // { "milestone_10_children": {"bonus": 5000}, "monthly_target_100k": {"bonusPercent": 2}, ... }
  bonusRules      Json?
  // ── Caps & Limits ──────────────────────────────────────────────────────────
  maxSharePerTransaction Float? // Cap per single transaction (null = no cap)
  maxMonthlyEarning      Float? // Monthly earning cap (null = no cap)
  // ── Extra configurable options (infinite) ──────────────────────────────────
  options         Json?    // Any additional config: {"clawbackDays": 30, "taxDeduction": 10, "referralBonus": 500, ...}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("revenue_share_configs")
}

// Individual revenue share transactions (ledger)
model RevenueShareLedger {
  id              String   @id @default(cuid())
  // Who earned
  beneficiarySiteId String  // The site receiving the share
  // Source of revenue
  sourceSiteId    String   // The site that generated the revenue
  sourceOrderId   String?  // Optional: linked to a specific order
  sourcePlanId    String?  // Optional: linked to a subscription payment
  // Amount
  grossAmount     Float    // Total revenue from source
  sharePercent    Float    // % applied
  shareAmount     Float    // Actual amount earned
  level           Int      // 1 = direct child, 2 = grandchild, etc.
  // Type & classification
  revenueType     String   @default("order") // order, subscription, ad_revenue, commission, tip, custom...
  platformType    String?  // ecommerce, streaming, trading, lms, custom...
  // Status
  status          String   @default("PENDING") // PENDING, HELD, APPROVED, PROCESSING, PAID, CANCELLED, CLAWED_BACK
  heldUntil       DateTime? // Hold period end date
  paidAt          DateTime?
  payoutRef       String?  // Payment reference
  payoutMethod    String?  // bank_transfer, wallet, upi, crypto, paypal...
  // Metadata (infinite)
  description     String?
  metadata        Json?    // Any extra data: {"invoiceId": "...", "taxDeducted": 200, ...}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([beneficiarySiteId, status])
  @@index([beneficiarySiteId, revenueType])
  @@index([sourceSiteId, createdAt])
  @@index([status, heldUntil])
  @@index([createdAt])
  @@map("revenue_share_ledger")
}

// Aggregated payouts (summary per period)
model RevenueSharePayout {
  id              String   @id @default(cuid())
  siteId          String   // Site receiving payout
  period          String   // "2026-06", "2026-W22", "2026-06-01" (depends on interval)
  totalEarned     Float    @default(0)
  totalPaid       Float    @default(0)
  pendingAmount   Float    @default(0)
  status          String   @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, CANCELLED
  paidAt          DateTime?
  payoutMethod    String?  // bank_transfer, wallet, upi, crypto, paypal...
  payoutRef       String?
  // Detailed breakdown (infinite)
  breakdown       Json?    // { "level1": 5000, "level2": 2000, "byType": {"order": 4000, "subscription": 3000}, "byPlatform": {"streaming": 5000} }
  // Extra metadata
  metadata        Json?    // { "taxDeducted": 500, "processingFee": 50, "bonusAdded": 1000 }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([siteId, period])
  @@index([siteId, status])
  @@map("revenue_share_payouts")
}

enum SiteStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model SiteDomain {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  hostname    String   @unique // "shop.tenant1.com" or "tenant1.platform.com"
  type        String   @default("SUBDOMAIN") // SUBDOMAIN | CUSTOM
  sslStatus   String   @default("PENDING") // PENDING | ACTIVE | FAILED
  sslCert     String?
  sslKey      String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([siteId])
  @@map("site_domains")
}

// Per-site admin access — links users to sites they can administer
model SiteAdmin {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([])  // Granular permissions granted by master admin
  createdAt   DateTime @default(now())

  @@unique([siteId, userId])
  @@index([userId])
  @@map("site_admins")
}

// Per-tenant product override — links to shared Product
model SiteProduct {
  id            String        @id @default(cuid())
  siteId        String
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  productId     String                              // FK to shared Product
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  isVisible     Boolean       @default(true)
  sortOrder     Int           @default(0)
  addedAt       DateTime      @default(now())

  // Price overrides (null = use shared price)
  price         Decimal?
  comparePrice  Decimal?
  discountType  DiscountType  @default(NONE)
  discountValue Decimal?

  // Availability overrides
  stock         Int?      // null = use shared stock
  isAvailable   Boolean   @default(true)

  // Custom slug per tenant (null = use shared slug)
  customSlug    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([siteId, productId])
  @@index([siteId])
  @@map("site_products")
}

model SiteCategory {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  categoryId String   // FK to shared Category
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  customName String?  // override category name
  customSlug String?  // override slug
  createdAt  DateTime @default(now())

  @@unique([siteId, categoryId])
  @@index([siteId])
  @@map("site_categories")
}

model SiteBrand {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  brandId   String   // FK to shared Brand
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([siteId, brandId])
  @@index([siteId])
  @@map("site_brands")
}

model SiteBanner {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String
  link        String?
  position    Int      @default(0)  // 0=hero, 1=top, 2=bottom
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([siteId, position, isActive])
  @@map("site_banners")
}

model SiteMenu {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String     // "main", "footer", "mobile"
  label       String
  href        String     // "/category/electronics"
  icon        String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      SiteMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    SiteMenu[] @relation("MenuHierarchy")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@index([siteId, name, isActive])
  @@map("site_menus")
}

model SitePage {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String   // "about", "contact", "shipping"
  title       String
  content     Json?    // {blocks: [...]}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, slug])
  @@map("site_pages")
}

// ===================== SEARCH ANALYTICS =====================

model SearchAnalytics {
  id               String   @id @default(cuid())
  query            String
  normalizedQuery  String   // lowercase, trimmed
  resultCount      Int      @default(0)
  clickedProductId String?
  clickPosition    Int?
  userId           String?
  sessionId        String?
  regionId         String?
  siteId           String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([normalizedQuery, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@index([resultCount])
  @@map("search_analytics")
}

// ===================== FRAUD RULES =====================

model FraudRule {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // VELOCITY, AMOUNT, DEVICE, LOCATION, IP_VELOCITY, CUSTOM
  config    Json     // rule-specific configuration
  weight    Float    @default(1.0)
  enabled   Boolean  @default(true)
  action    String   @default("FLAG") // FLAG, BLOCK, REVIEW
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, enabled])
  @@map("fraud_rules")
}

// ===================== PERFORMANCE METRICS =====================

model PerformanceMetric {
  id        String   @id @default(cuid())
  page      String
  metric    String   // LCP, FID, CLS, INP, FCP, TTFB
  value     Float
  rating    String   // good, needs_improvement, poor
  userId    String?
  sessionId String?
  device    String?  // mobile, desktop, tablet
  browser   String?
  createdAt DateTime @default(now())

  @@index([metric, createdAt])
  @@index([page, metric])
  @@index([rating])
  @@map("performance_metrics")
}

// ===================== DELIVERY FEEDBACK =====================

model DeliveryFeedback {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  deliveryAgentId String?
  overallRating   Int      // 1-5
  agentRating     Int?     // 1-5
  timelinessRating Int?    // 1-5
  handlingRating  Int?     // 1-5
  comment         String?
  tags            String[] // "on_time", "careful", "polite", etc.
  isAnonymous     Boolean  @default(false)
  userId          String?
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([deliveryAgentId])
  @@index([overallRating])
  @@map("delivery_feedbacks")
}

