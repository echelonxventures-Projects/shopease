  category  String   @default("General")
  question  String
  answer    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
  @@map("faqs")
}

// ===================== BRAND STORIES =====================

model BrandStory {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title     String
  content   String
  heroImage String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([brandId])
  @@map("brand_stories")
}

// ===================== SOCIAL SHARING =====================

model SocialShare {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  platform  String   // whatsapp, facebook, twitter, telegram, etc.
  sharedAt  DateTime @default(now())

  @@index([productId])
  @@map("social_shares")
}

// ===================== DELIVERY SLOTS =====================

model DeliverySlot {
  id           String   @id @default(cuid())
  date         DateTime
  timeFrom     DateTime
  timeTo       DateTime
  maxOrders    Int      @default(100)
  bookedOrders Int      @default(0)
  isActive     Boolean  @default(true)
  fee          Decimal  @default(0)
  createdAt    DateTime @default(now())

  orders       Order[]
  @@index([date, isActive])
  @@map("delivery_slots")
}

// ===================== WISHLIST =====================

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shareToken  String?  @unique
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, productId, variantId])
}

// ===================== CUSTOM LISTS =====================

model CustomList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  shareToken  String?  @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CustomListItem[]
  @@index([userId])
  @@index([shareToken])
  @@map("custom_lists")
}

model CustomListItem {
  id          String   @id @default(cuid())
  listId      String
  list        CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  note        String?
  createdAt   DateTime @default(now())

  @@unique([listId, productId])
  @@index([listId])
  @@map("custom_list_items")
}

// ===================== AMAZON BUSINESS LAYER =====================

enum BusinessType {
  LLC
  CORPORATION
  SOLE_PROPRIETOR
  PARTNERSHIP
  NONPROFIT
  GOVERNMENT
  EDUCATIONAL
  OTHER
}

enum BusinessVerificationStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BusinessUserRole {
  OWNER
  ADMIN
  MANAGER
  BUYER
}

enum RFQStatus {
  OPEN
  IN_REVIEW
  CLOSED
  AWARDED
  CANCELLED
}

enum RFQPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RFQResponseStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum B2BPaymentTerms {
  CASH
  NET_15
  NET_30
  NET_60
  NET_90
}

enum TaxExemptionType {
  GST_EXEMPT
  VAT_EXEMPT
  RESALE_CERTIFICATE
  NONPROFIT_EXEMPT
  GOVERNMENT_EXEMPT
  EDUCATIONAL_EXEMPT
}

model BusinessProfile {
  id                  String                @id @default(cuid())
  name                String
  businessType        BusinessType          @default(OTHER)
  industry            String?
  companySize         String?               // "1-10", "11-50", "51-200", "201-1000", "1000+"
  website             String?
  gstNumber           String?               // GST Identification Number (India)
  taxId               String?               // Tax ID / EIN / VAT number
  panNumber           String?               // PAN card (India)
  registrationNumber  String?               // Company registration number
  registeredCountry   String?               // ISO country code
  businessAddress     String?
  city                String?
  state               String?
  zipCode             String?
  countryId           String?
  stateId             String?
  contactEmail        String?
  contactPhone        String?
  verificationStatus  BusinessVerificationStatus @default(PENDING)
  verifiedBy          String?
  verifiedAt          DateTime?
  adminNotes          String?
  logo                String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  users               BusinessUser[]
  documents           BusinessDocument[]
  verifications       BusinessVerification[]
  approvalRules       BusinessApprovalRule[]
  rfqs                RFQ[]
  taxExemptions       BusinessTaxExemption[]
  b2bOrders           B2BOrder[]
  businessPrices      BusinessTierPrice[]
  analyticsSnapshots  BusinessAnalyticsSnapshot[]

  @@index([gstNumber])
  @@index([taxId])
  @@index([verificationStatus])
  @@map("business_profiles")
}

model BusinessDocument {
  id          String   @id @default(cuid())
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  docType     String   // "GST_CERTIFICATE", "BUSINESS_LICENSE", "PAN_CARD", "TAX_CERTIFICATE", "RESALE_CERTIFICATE"
  docNumber   String?
  fileUrl     String?
  status      String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@map("business_documents")
}

model BusinessVerification {
  id           String   @id @default(cuid())
  businessId   String
  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status       BusinessVerificationStatus @default(PENDING)
  steps        Json?    // [{step: "GST_VERIFICATION", status: "VERIFIED", checkedBy: "...", checkedAt: "..."}]
  assignedAdminId String?
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@map("business_verifications")
}

model BusinessUser {
  id          String           @id @default(cuid())
  businessId  String
  business    BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        BusinessUserRole @default(BUYER)
  email       String?          // email at time of invite (for pending invites)
  inviteToken String?          @unique
  isActive    Boolean          @default(true)
  approvedBy  String?
  approvedAt  DateTime?
  lastActive  DateTime?
  createdAt   DateTime         @default(now())

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([inviteToken])
  @@map("business_users")
}

model BusinessApprovalRule {
  id                     String   @id @default(cuid())
  businessId             String
  business               BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type                   String   // "ORDER_APPROVAL", "DISCOUNT_APPROVAL", "RFQ_APPROVAL"
  minOrderAmount         Decimal? @db.Decimal(12, 2)
  maxDiscount            Decimal? @db.Decimal(5, 2)
  approverRole           BusinessUserRole?
  approverId             String?
  requiresMultiApprover  Boolean  @default(false)
  minApprovers           Int      @default(2)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([businessId])
  @@map("business_approval_rules")
}

model RFQ {
  id          String         @id @default(cuid())
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      RFQStatus      @default(OPEN)
  category    String?
  priority    RFQPriority    @default(MEDIUM)
  deadline    DateTime?
  currency    String         @default("INR")
  createdBy   String?        // userId of creator
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  items       RFQItem[]
  responses   RFQResponse[]

  @@index([businessId])
  @@index([status])
  @@map("rfqs")
}

model RFQItem {
  id             String   @id @default(cuid())
  rfqId          String
  rfq            RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId      String?
  productName    String
  description    String?
  quantity       Decimal
  unitOfMeasure  String   @default("PIECE")
  targetPrice    Decimal? @db.Decimal(12, 2)
  notes          String?

  @@index([rfqId])
  @@map("rfq_items")
}

model RFQResponse {
  id          String              @id @default(cuid())
  rfqId       String
  rfq         RFQ                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  status      RFQResponseStatus   @default(PENDING)
  totalAmount Decimal
  currency    String              @default("INR")
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       RFQResponseItem[]

  @@index([rfqId])
  @@index([sellerId])
  @@map("rfq_responses")
}

model RFQResponseItem {
  id              String   @id @default(cuid())
  responseId      String
  response        RFQResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  productId       String?
  productName     String
  quantity        Decimal
  unitOfMeasure   String   @default("PIECE")
  unitPrice       Decimal  @db.Decimal(12, 2)
  discount        Decimal? @db.Decimal(5, 2)
  deliveryDays    Int?
  leadTime        String?
  notes           String?

  @@index([responseId])
  @@map("rfq_response_items")
}

model BusinessTaxExemption {
  id                String             @id @default(cuid())
  businessId        String
  business          BusinessProfile    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  regionCode        String             // "IN-MH", "US-CA", etc.
  exemptionType     TaxExemptionType
  certificateNumber String
  issuedBy          String?
  validFrom         DateTime?
  validUntil        DateTime?
  fileUrl           String?
  status            String             @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([businessId])
  @@index([regionCode])
  @@map("business_tax_exemptions")
}

model StateTaxRule {
  id           String   @id @default(cuid())
  country      String   // "IN", "US", "GB", "DE", "AU"
  state        String?  // "MH", "CA", null for country-level
  taxType      String   // "GST", "CGST", "SGST", "IGST", "VAT", "SALES_TAX", "CST"
  cgstRate     Decimal? @db.Decimal(5, 2)
  sgstRate     Decimal? @db.Decimal(5, 2)
  igstRate     Decimal? @db.Decimal(5, 2)
  totalRate    Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo  DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([country, state, taxType, effectiveFrom])
  @@index([country])
  @@index([state])
  @@map("state_tax_rules")
}

model B2BOrder {
  id                    String         @id @default(cuid())
  orderId               String    @unique
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessId            String
  business              BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrderNumber   String?
  taxExempt             Boolean        @default(false)
  taxExemptionId        String?
  paymentTerms          B2BPaymentTerms @default(CASH)
  approvedBy            String?
  approvedAt            DateTime?
  approvalNotes         String?
  totalBeforeTax        Decimal        @default(0) @db.Decimal(12, 2)
  totalTax              Decimal        @default(0) @db.Decimal(12, 2)
  totalAfterTax         Decimal        @default(0) @db.Decimal(12, 2)
  createdAt             DateTime       @default(now())

  @@index([businessId])
  @@index([purchaseOrderNumber])
  @@map("b2b_orders")
}

model BusinessTierPrice {
  id                 String   @id @default(cuid())
  businessId         String
  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId          String
  minQty             Int
  maxQty             Int?
  price              Decimal? @db.Decimal(12, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId, productId])
  @@map("business_tier_prices")
}

model BusinessAnalyticsSnapshot {
  id                 String   @id @default(cuid())
  businessId         String
  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month              String   // "2026-05"
  totalSpend         Decimal  @default(0) @db.Decimal(14, 2)
  orderCount         Int      @default(0)
  avgOrderValue      Decimal  @default(0) @db.Decimal(12, 2)
  categoryBreakdown  Json?    // {"Electronics": 50000, "Office Supplies": 20000}
  topProducts        Json?    // [{"productId": "...", "name": "...", "qty": 100, "amount": 5000}]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([businessId, month])
  @@index([businessId])
  @@map("business_analytics_snapshots")
}

// Add relation to User model for business profiles
// (User.businessProfiles will be added below)

model ConversionEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String   // Anonymous session tracking
  type      String   // PAGE_VIEW, ADD_TO_CART, START_CHECKOUT, PAYMENT, PURCHASE
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
  @@index([sessionId, type, createdAt])
}

// ===================== COUPONS & PROMOTIONS =====================

// @deprecated Use Promo model with type=COUPON. No new coupon records.

model Coupon {
  id                   String       @id @default(cuid())
  code                 String       @unique
  codeHash             String?
  encryptedCode        String?
  description          String?
  discountType         DiscountType @default(PERCENTAGE)
  discountValue        Decimal
  minOrderValue        Decimal?
  maxDiscount          Decimal?
  usageLimit           Int?
  usedCount            Int          @default(0)
  validFrom            DateTime
  validUntil           DateTime?
  isActive             Boolean      @default(true)
  applicableProductIds String[]     @default([])

  @@index([codeHash, isActive])
  @@index([code, isActive])
}

// ===================== PROMOTIONS ENGINE =====================

model Promo {
  id                      String            @id @default(cuid())
  code                    String?           @unique
  codeHash                String?           @unique
  encryptedCode           String?
  type                    PromoType
  title                   String
  description             String?
  status                  PromoStatus       @default(DRAFT)
  discountType            PromoDiscountType
  discountValue           Decimal
  maxDiscount             Decimal?
  minOrderValue           Decimal?
  minQuantity             Int?
  maxUses                 Int?
  usedCount               Int               @default(0)
  perUserLimit            Int?
  validFrom               DateTime
  validUntil              DateTime?
  applicableProductIds    String[]          @default([])
  applicableCategoryIds   String[]          @default([])
  applicableBrandIds      String[]          @default([])
  excludedProductIds      String[]          @default([])
  rules                   Json?
  stackingGroup           String?
  priority                Int               @default(0)
  isActive                Boolean           @default(true)
  appOnly                 Boolean           @default(false)
  regionId                String?
  region                  Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  translations            PromoTranslation[]
  conditions              PromotionCondition[]
  effects                 PromotionEffect[]
  links                   PromotionLink[]
  bankOffer               BankOffer?
  shippingPromo           ShippingPromotion?
  paymentMethodPromo      PaymentMethodPromotion?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  usages                  PromoUsage[]
  clippedCoupons          ClippedCoupon[]
  lightningDeal           LightningDeal?
  multiBuyTier            MultiBuyTier?
  giftWithPurchase        GiftWithPurchase?
  crossCategoryBundle     CrossCategoryBundle?
  abTestAsA               ABTestPromo[]  @relation("ABTestA")
  abTestAsB               ABTestPromo[]  @relation("ABTestB")
  searchPromoTriggers     SearchPromoTrigger[]
  pincodePromos           PincodePromo[]
  vipDeal                 VIPDeal?
  subscribePromos         SubscribePromo?
  promoExplanations       PromoExplanation[]
  promoSchedulers         PromoScheduler[]
  promoBudgetCap          PromoBudgetCap?
  promoAnalytics          PromoAnalytics[]

  @@index([code])
  @@index([type, status])
  @@index([validFrom, validUntil])
  @@index([isActive])
  @@index([regionId, isActive, status])
}

enum PromoType {
  BANK_OFFER
  BRAND_OFFER
  CATEGORY_OFFER
  FLASH_SALE
  FESTIVE_OFFER
  BOGO
  COMBO
  TIME_BASED
  MINIMUM_SPEND
  COUPON
  SEASONAL
  NEW_USER
}

enum PromoStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  COMPLETED
}

enum PromoDiscountType {
  PERCENTAGE
  FLAT
  FREE_ITEM
  BUY_X_GET_Y
}

model PromoTranslation {
  id          String   @id @default(cuid())
  promoId     String
  promo       Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  locale      String   // "en", "hi", "de", "ja", etc.
  title       String
  description String?

  @@unique([promoId, locale])
  @@index([locale])
}

model PromoUsage {
  id        String   @id @default(cuid())
  promoId   String
  promo     Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  userId    String?
  orderId   String?
  discount  Decimal
  appliedAt DateTime @default(now())

  @@index([promoId])
  @@index([userId])
  @@index([orderId])
}

// ===================== PROMOTION ENGINE (MODULAR) =====================

enum PromotionConditionType {
  PRODUCT_IN
  CATEGORY_IN
  BRAND_IN
  MIN_ORDER_VALUE
  MIN_QUANTITY
  MAX_ORDER_VALUE
  EXCLUDED_PRODUCT
  USER_TAG
  LOCATION
  PAYMENT_METHOD
  TIME_WINDOW
  FIRST_ORDER
  MIN_ITEM_PRICE
  CART_HAS_VARIANT
}

enum PromotionEffectType {
  PERCENTAGE_OFF
  FLAT_OFF
  FREE_ITEM
  BUY_X_GET_Y
  FREE_SHIPPING
  SHIPPING_FLAT_FEE
  SHIPPING_DISCOUNT
  BANK_CASHBACK
  PAYMENT_METHOD_DISCOUNT
}

enum PromotionStackStrategy {
  BEST_WINS
  ADDITIVE
  EXCLUSIVE
}

enum EffectScope {
  ITEM
  SHIPPING
  TOTAL
}

// Explicit, queryable conditions (replaces opaque `rules: Json?`)
model PromotionCondition {
  id           String                  @id @default(cuid())
  promotionId  String
  promotion    Promo                   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type         PromotionConditionType
  scope        String?                 // "productIds", "categoryIds", "brandIds", "paymentMethods", etc.
  value        String?                 // comma-separated IDs or JSON for complex conditions
  minValue     Decimal?                // for MIN_ORDER_VALUE, MIN_QUANTITY, etc.
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@index([promotionId])
  @@map("promotion_conditions")
}

// What happens when conditions match
model PromotionEffect {
  id           String              @id @default(cuid())
  promotionId  String
  promotion    Promo               @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type         PromotionEffectType
  value        Decimal?            // percentage (15) or flat amount (500)
  maxDiscount  Decimal?            // cap for percentage discounts
  scope        EffectScope         @default(TOTAL)
  config       Json?               // extra handler-specific config
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([promotionId])
  @@map("promotion_effects")
}

// What the promotion applies to (replaces applicableProductIds, applicableCategoryIds, etc.)
model PromotionLink {
  id          String  @id @default(cuid())
  promotionId String
  promotion   Promo   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetType  String  // "PRODUCT", "CATEGORY", "BRAND"
  targetId    String
  sortOrder   Int     @default(0)

  @@unique([promotionId, targetType, targetId])
  @@index([promotionId])
  @@map("promotion_links")
}

// Gateway-linked bank offers
model BankOffer {
  id              String            @id @default(cuid())
  promotionId     String            @unique
  promotion       Promo             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  gatewayId       String?
  gateway         PaymentGateway?   @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  bankName        String
  bankCode        String?
  cardType        String            @default("ALL") // CREDIT|DEBIT|UPI|NETBANKING|ALL
  discountType    PromotionEffectType
  discountValue   Decimal
  maxDiscount     Decimal?
  minOrderValue   Decimal?
  emiTenure       Int?              // for EMI-specific offers
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@index([gatewayId])
  @@index([bankCode])
  @@map("bank_offers")
}

// Shipping discount rules
model ShippingPromotion {
  id              String            @id @default(cuid())
  promotionId     String            @unique
  promotion       Promo             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type            PromotionEffectType // FREE_SHIPPING, SHIPPING_FLAT_FEE, SHIPPING_DISCOUNT
  discountValue   Decimal?          // percentage or flat fee
  maxDiscount     Decimal?
  minOrderValue   Decimal?
  maxWeightKg     Decimal?
  appliesToZone   String?           // ALL|SELECTED|EXCLUDED
  zoneIds         String[]          @default([])
  deliverySpeed   String?           // ALL|STANDARD|EXPRESS|SAME_DAY
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@map("shipping_promotions")
}

// Discounts for specific payment methods
model PaymentMethodPromotion {
  id              String            @id @default(cuid())
  promotionId     String            @unique
  promotion       Promo             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  methodType      String            // CARD|UPI|WALLET|NETBANKING|PAYPAL|APPLE_PAY|etc.
  gatewayId       String?
  gateway         PaymentGateway?   @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  discountType    PromotionEffectType
  discountValue   Decimal?
  maxDiscount     Decimal?
  minOrderValue   Decimal?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@index([methodType])
  @@map("payment_method_promotions")
}

// Stacking group configuration
model PromotionStackRule {
  id              String                  @id @default(cuid())
  group           String
  strategy        PromotionStackStrategy  @default(BEST_WINS)
  maxPromos       Int                     @default(1)
  description     String?
  isActive        Boolean                 @default(true)

  @@unique([group])
  @@map("promotion_stack_rules")
}

// ===================== CLIPPED COUPONS (Amazon-style) =====================

model ClippedCoupon {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoId     String
  promo       Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  clippedAt   DateTime @default(now())
  appliedAt   DateTime?
  expiredAt   DateTime?

  @@unique([userId, promoId])
  @@index([userId])
  @@map("clipped_coupons")
}

// ===================== LOYALTY PROGRAM =====================

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model LoyaltyProgram {
  id               String      @id @default(cuid())
  name             String
  pointsPerRupee   Decimal     @default(1)
  minRedeemPoints  Int         @default(100)
  pointsExpiryDays Int         @default(365)
  tierBronzeMin    Int         @default(0)
  tierSilverMin    Int         @default(5000)
  tierGoldMin      Int         @default(20000)
  tierPlatinumMin  Int         @default(50000)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("loyalty_programs")
}

model LoyaltyTransaction {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String        // EARN|REDEEM|EXPIRE|ADJUST
  points      Int
  balance     Int
  referenceId String?       // orderId, promoId, etc.
  description String?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([userId, type])
  @@map("loyalty_transactions")
}

// ===================== REFERRAL PROMOS =====================

model ReferralPromo {
  id               String   @id @default(cuid())
  name             String
  referrerReward   Decimal  // reward for the person who referred
  refereeReward    Decimal  // reward for the new user
  rewardType       String   // POINTS|FLAT|PERCENTAGE
  rewardValue      Decimal
  maxRewardUsages  Int?
  minOrderValue    Decimal?
  validFrom        DateTime
  validUntil       DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  referrals        ReferralReward[]
  @@map("referral_promos")
}

model ReferralReward {
  id             String   @id @default(cuid())
  referralPromoId String
  referralPromo  ReferralPromo @relation(fields: [referralPromoId], references: [id], onDelete: Cascade)
  referrerId     String   // user who referred
  refereeId      String   // new user who signed up
  referrerReward Decimal
  refereeReward  Decimal
  status         String   @default("PENDING") // PENDING|CLAIMED|EXPIRED
  claimedAt      DateTime?
  refereeOrderId String?
  createdAt      DateTime @default(now())

  @@index([referrerId])
  @@index([refereeId])
  @@unique([referrerId, refereeId])
  @@map("referral_rewards")
}

// ===================== LIGHTNING DEALS =====================

model LightningDeal {
  id              String   @id @default(cuid())
  promoId         String   @unique
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  totalSlots      Int          // total number of redemptions available
  claimedSlots    Int          @default(0)
  startTime       DateTime
  endTime         DateTime
  perUserLimit    Int          @default(1)
  isActive        Boolean      @default(true)

  claims          LightningDealClaim[]
  @@index([startTime, endTime])
  @@index([isActive])
  @@map("lightning_deals")
}

model LightningDealClaim {
  id          String   @id @default(cuid())
  dealId      String
  deal        LightningDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId      String
  orderId     String?
  claimedAt   DateTime @default(now())

  @@unique([dealId, userId])
  @@index([userId])
  @@map("lightning_deal_claims")
}

// ===================== MULTI-BUY TIERS =====================

model MultiBuyTier {
  id              String   @id @default(cuid())
  promoId         String   @unique
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  tiers           Json         // [{minQty:3,discount:{type:"PERCENTAGE",value:10}},{minQty:5,...}]
  appliesToScope  String   @default("CART") // CART|CATEGORY|BRAND
  createdAt       DateTime @default(now())

  @@map("multi_buy_tiers")
}

// ===================== GIFT WITH PURCHASE =====================

model GiftWithPurchase {
  id               String   @id @default(cuid())
  promoId          String   @unique
  promo            Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  minOrderValue    Decimal
  giftProductId    String
  giftProduct      Product  @relation(fields: [giftProductId], references: [id])
  maxGifts         Int      @default(1)
  maxRedemptions   Int?
  redeemedCount    Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("gift_with_purchases")
}

// ===================== CROSS-CATEGORY BUNDLE =====================

model CrossCategoryBundle {
  id               String   @id @default(cuid())
  promoId          String   @unique
  promo            Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  categoryIds      String[]     // categories that must all be in cart
  bundleDiscountType String   // FLAT|PERCENTAGE
  bundleDiscountValue Decimal
  maxDiscount      Decimal?
  minItemsPerCategory Int   @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("cross_category_bundles")
}

// ===================== DYNAMIC PRICING =====================

enum PriceTrigger {
  HIGH_STOCK
  LOW_STOCK
  EXPIRY_SOON
  DEMAND_SPIKE
  COMPETITOR_LOW
  SEASON_END
}

model AutoPromoTrigger {
  id            String          @id @default(cuid())
  name          String
  triggerType   PriceTrigger
  productId     String?
  categoryId    String?
  condition     Json              // {stockAbove:100, discountType:"PERCENTAGE", discountValue:15}
  promoId       String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@index([triggerType])
  @@map("auto_promo_triggers")
}

model DynamicPriceRule {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  basePrice       Decimal
  minPrice        Decimal?
  maxPrice        Decimal?
  demandMultiplier Decimal? @default(1)
  stockDiscount   Decimal?  // discount when stock is high
  lastPriceAt     DateTime @default(now())
  priceHistory    Json?

  @@unique([productId])
  @@map("dynamic_price_rules")
}

// ===================== BEHAVIORAL PROMO TRIGGERS =====================

enum BehavioralType {
  BROWSE_ABANDONMENT
  CART_ABANDONMENT
  WIN_BACK
  INACTIVE_USER
  REPEAT_PURCHASE
  CATEGORY_EXPLORER
}

model BehavioralPromoTrigger {
  id              String           @id @default(cuid())
  name            String
  type            BehavioralType
  condition       Json               // {daysSinceLastView:3,discountType:"PERCENTAGE",discountValue:10}
  promoId         String?
  maxTriggersPerUser Int?
  cooldownHours   Int              @default(24)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  @@index([type])
  @@map("behavioral_promo_triggers")
}

model BrowseHistory {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  productId   String
  viewedAt    DateTime @default(now())
  duration    Int?         // seconds spent viewing

  @@index([userId, viewedAt])
  @@index([productId])
  @@map("browse_histories")
}

model CartSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActivity   DateTime @default(now())
  abandonedAt    DateTime?
  promoTriggered Boolean  @default(false)

  @@index([userId, lastActivity])
  @@index([abandonedAt, lastActivity])
  @@map("cart_sessions")
}

// ===================== PROMO ANALYTICS =====================

model PromoAnalytics {
  id              String   @id @default(cuid())
  promoId         String
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  redemptions     Int      @default(0)
  totalDiscount   Decimal  @default(0)
  revenueWith     Decimal  @default(0)
  revenueWithout  Decimal  @default(0)
  conversionRate  Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([promoId, date])
  @@index([promoId])
  @@map("promo_analytics")
}

model PromoClick {
  id          String   @id @default(cuid())
  promoId     String
  userId      String?
  sessionId   String?
  clickedAt   DateTime @default(now())
  source      String?  // "cart", "product_page", "search", "banner"
  metadata    Json?

  @@index([promoId])
  @@map("promo_clicks")
}

// ===================== PROMO SCHEDULER + BUDGET CAPS =====================

model PromoScheduler {
  id              String   @id @default(cuid())
  promoId         String   @unique
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  scheduledStart  DateTime
  scheduledEnd    DateTime?
  autoPublish     Boolean  @default(true)
  lastState       String?
  auditLog        Json?
  createdAt       DateTime @default(now())

  @@map("promo_schedulers")
}

model PromoBudgetCap {
  id              String   @id @default(cuid())
  promoId         String   @unique
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  totalBudget     Decimal
  spent           Decimal  @default(0)
  dailyLimit      Decimal?
  dailySpent      Decimal  @default(0)
  lastResetDate   DateTime?
  isExceeded      Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@map("promo_budget_caps")
}

// ===================== A/B TESTING =====================

model ABTestPromo {
  id              String   @id @default(cuid())
  name            String
  promoIdA        String
  promoA          Promo    @relation("ABTestA", fields: [promoIdA], references: [id])
  promoIdB        String
  promoB          Promo    @relation("ABTestB", fields: [promoIdB], references: [id])
  trafficSplit    Int      @default(50) // % going to A
  startDate       DateTime
  endDate         DateTime?
  status          String   @default("RUNNING")
  winnerPromoId   String?
  createdAt       DateTime @default(now())

  assignments     ABTestAssignment[]
  @@map("ab_test_promos")
}

model ABTestAssignment {
  id          String   @id @default(cuid())
  testId      String
  test        ABTestPromo @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId      String
  variant     String   // "A"|"B"
  assignedAt  DateTime @default(now())

  @@unique([testId, userId])
  @@index([testId])
  @@map("ab_test_assignments")
}

// ===================== GAMIFIED PROMOS =====================

enum GamificationType {
  SPIN_WHEEL
  SCRATCH_CARD
  MYSTERY_BOX
  TREASURE_HUNT
}

model GamifiedPromo {
  id              String           @id @default(cuid())
  name            String
  type            GamificationType
  prizes          Json               // [{type:"PERCENTAGE",value:10,weight:30},{type:"FLAT",value:50,weight:20}]
  maxPerUser      Int              @default(1)
  validFrom       DateTime
  validUntil      DateTime?
  totalPrizes     Int
  claimedPrizes   Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  plays           GamifiedPlay[]
  @@map("gamified_promos")
}

model GamifiedPlay {
  id          String   @id @default(cuid())
  promoId     String
  promo       GamifiedPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  userId      String
  prizeType   String
  prizeValue  Decimal
  promoIdApplied String?  // FK to Promo if prize creates a promo
  playedAt    DateTime @default(now())

  @@index([userId])
  @@map("gamified_plays")
}

// ===================== SEARCH-TRIGGERED PROMOS =====================

model SearchPromoTrigger {
  id          String   @id @default(cuid())
  keyword     String
  promoId     String
  promo       Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  matchType   String   @default("CONTAINS") // CONTAINS|EXACT|CATEGORY
  isActive    Boolean  @default(true)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([keyword, promoId])
  @@index([keyword])
  @@map("search_promo_triggers")
}

// ===================== PINCODE PROMO =====================

model PincodePromo {
  id          String   @id @default(cuid())
  promoId     String
  promo       Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  pincodes    String[]
  isActive    Boolean  @default(true)

  @@unique([promoId, pincodes(0)])
  @@index([promoId])
  @@map("pincode_promos")
}

// ===================== VIP EXCLUSIVE DEALS =====================

model VIPDeal {
  id              String   @id @default(cuid())
  promoId         String   @unique
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  requiredTier    LoyaltyTier
  requiredTag     String?  // custom tag like "PRIME_MEMBER"
  maxRedemptions  Int?
  redeemedCount   Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("vip_deals")
}

// ===================== SUBSCRIBE & SAVE PROMO =====================

model SubscribePromo {
  id              String   @id @default(cuid())
  promoId         String   @unique
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tieredDiscounts Json         // [{cycle:1,discount:5},{cycle:3,discount:10},{cycle:6,discount:15}]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("subscribe_promos")
}

// ===================== PROMO EXPLANATION / BREAKDOWN =====================

model PromoExplanation {
  id              String   @id @default(cuid())
  promoId         String
  promo           Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  template        String       // "Save {amount} on {category} with {bank}"
  variables       Json         // {amount:"₹500",category:"Electronics",bank:"HDFC"}
  locale          String   @default("en")
  createdAt       DateTime @default(now())

  @@index([promoId])
  @@map("promo_explanations")
}

// ===================== PAYMENT GATEWAYS =====================

model PaymentGateway {
  id          String   @id @default(cuid())
  provider    String   @unique
  name        String
  logo        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions                 PaymentGatewayRegion[]
  methods                 PaymentGatewayMethod[]
  sites                   PaymentGatewaySite[]
  categories              PaymentGatewayCategory[]
  banks                   PaymentGatewayBank[]
  commissions             PaymentGatewayCommission[]
  transactions            PaymentTransaction[]
  bankOffers              BankOffer[]
  paymentMethodPromotions PaymentMethodPromotion[]
}

model PaymentGatewayRegion {
  id          String   @id @default(cuid())
  gatewayId   String
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  isPrimary   Boolean  @default(false)
  priority    Int      @default(0)
  config      Json?
  currency    String?

  @@unique([gatewayId, regionId])
  @@index([regionId, isActive])
}

model PaymentGatewayMethod {
  id          String            @id @default(cuid())
  gatewayId   String
  gateway     PaymentGateway    @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  method      PaymentMethodType
  name        String
  icon        String?
  isEnabled   Boolean           @default(true)
  config      Json?

  @@unique([gatewayId, method])
  @@index([gatewayId])
}

model PaymentGatewaySite {
  id          String         @id @default(cuid())
  gatewayId   String
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  siteId      String
  site        Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  isActive    Boolean        @default(true)
  isPrimary   Boolean        @default(false)
  priority    Int            @default(0)
  config      Json?

  @@unique([gatewayId, siteId])
  @@index([siteId, isActive])
  @@map("payment_gateway_sites")
}

model PaymentGatewayCategory {
  id          String         @id @default(cuid())
  gatewayId   String
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive    Boolean        @default(true)
  priority    Int            @default(0)

  @@unique([gatewayId, categoryId])
  @@index([categoryId])
  @@map("payment_gateway_categories")
}

model PaymentGatewayBank {
  id          String         @id @default(cuid())
  gatewayId   String
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  bankName    String
  bankCode    String
  ifscPrefix  String?
  methods     String[]       // UPI, NETBANKING, CARD, etc.
  isActive    Boolean        @default(true)
  logo        String?

  @@unique([gatewayId, bankCode])
  @@index([gatewayId])
  @@map("payment_gateway_banks")
}

model PaymentGatewayCommission {
  id              String         @id @default(cuid())
  gatewayId       String
  gateway         PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  method          String?        // null = all methods
  cardNetwork     String?        // VISA, MASTERCARD, etc.
  type            String         @default("PERCENTAGE") // FLAT, PERCENTAGE, TIERED
  flatAmount      Float?
  percentage      Float?
  tiers           Json?          // [{minAmount, maxAmount, rate}]
  minCommission   Float?
  maxCommission   Float?
  currency        String         @default("INR")
  isActive        Boolean        @default(true)

  @@index([gatewayId])
  @@map("payment_gateway_commissions")
}

enum PaymentMethodType {
  CARD
  UPI
  WALLET
  NETBANKING
  BNPL
  CRYPTO
  BANK_TRANSFER
  CASH_ON_DELIVERY
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
  KLARNA
  AFTERPAY
}

model PaymentTransaction {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  gatewayId       String?
  gateway         PaymentGateway? @relation(fields: [gatewayId], references: [id])
  method          PaymentMethodType
  provider        String
  providerTxnId   String?
  amount          Decimal
  currency        String
  status          PaymentStatus   @default(PENDING)
  failureReason   String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([provider, providerTxnId])
  @@unique([provider, providerTxnId])
}

enum DiscountType {
  NONE
  PERCENTAGE
  FLAT
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  link        String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  siteId      String?
  site        Site?    @relation("SiteBanners", fields: [siteId], references: [id])
  createdAt   DateTime @default(now())
}

// ===================== CUSTOMER SUPPORT =====================

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  customerId      String
  customer        User           @relation("CustomerTickets", fields: [customerId], references: [id])
  assignedToId    String?
  assignedTo      User?          @relation("AgentTickets", fields: [assignedToId], references: [id])
  subject         String
  description     String
  category        TicketCategory @default(ORDER_ISSUE)
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  messages        TicketMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  resolvedAt      DateTime?

  @@index([customerId])
  @@index([ticketNumber])
  @@index([status])
}

enum TicketCategory {
  ORDER_ISSUE
  PRODUCT_QUESTION
  PAYMENT_PROBLEM
  DELIVERY_ISSUE
  ACCOUNT_ISSUE
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_MERCHANT
  RESOLVED
  CLOSED
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  message     String
  attachments String[]
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

// ===================== GDPR COMPLIANCE =====================

model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConsentType
  version     String      @default("1.0")
  consentedAt DateTime    @default(now())
  withdrawnAt DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@unique([userId, type, withdrawnAt])
  @@index([userId])
  @@index([type])
}

enum ConsentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  MARKETING_EMAILS
  MARKETING_SMS
  COOKIES_ANALYTICS
  COOKIES_MARKETING
}

// ===================== SYSTEM & AUDIT =====================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  siteId      String?  // Scoped to site hierarchy — admins see their site + children
  action      String
  entityType  String
  entityId    String?
  details     Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([siteId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemActivity {
  id           String           @id @default(cuid())
  siteId       String?          // Scoped to site hierarchy
  activityType String
  details      String?
  severity     ActivitySeverity @default(INFO)
  source       String?
  createdAt    DateTime         @default(now())

  @@index([siteId, activityType])
  @@index([activityType])
  @@index([createdAt])
}

enum ActivitySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String?
  updatedAt   DateTime @default(now())

  @@index([category])
}

// ===================== NOTIFICATIONS =====================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotifType @default(INFO)
  isRead    Boolean   @default(false)
  link      String?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
}

enum NotifType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER
  PROMOTION
}

// ===================== DELIVERY & LOGISTICS (QUICK COMMERCE) =====================

model DeliveryZone {
  id                  String            @id @default(cuid())
  name                String            @db.VarChar(100)
  code                String?           @unique @db.VarChar(20)
  regionId            String?
  region              Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  facilityLocationId  String?
  facilityLocation    Location?         @relation("DeliveryZoneFacility", fields: [facilityLocationId], references: [id], onDelete: SetNull)
  centerLat           Decimal?          @db.Decimal(9, 6)
  centerLng           Decimal?          @db.Decimal(9, 6)
  radiusKm            Decimal           @default(3) @db.Decimal(5, 2)
  isGeoFenced         Boolean           @default(false)
  isActive            Boolean           @default(true)
  deliveryTimeMin     Int               @default(10)
  deliveryTimeMax     Int               @default(30)
  minOrderValue       Decimal           @default(0) @db.Decimal(10, 2)
  deliveryFee         Decimal           @default(0) @db.Decimal(8, 2)
  freeDeliveryFrom    Decimal?          @db.Decimal(10, 2)
  coveragePolygon     Json?
  description         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  mfc                 MicroFulfillmentCenter?
  assignments         DeliveryAssignment[]
  agents              DeliveryAgent[]

  @@index([regionId, isActive])
  @@index([isActive])
  @@map("delivery_zones")
}

model MicroFulfillmentCenter {
  id                  String            @id @default(cuid())
  name                String            @db.VarChar(100)
  code                String?           @unique @db.VarChar(20)
  zoneId              String            @unique
  zone                DeliveryZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  locationId          String?
  location            Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  addressLine         String?
  lat                 Decimal?          @db.Decimal(9, 6)
  lng                 Decimal?          @db.Decimal(9, 6)
  contactPhone        String?
  operatingHours      Json?
  inventoryCapacity   Int               @default(5000)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([zoneId])
  @@index([isActive])
  @@map("micro_fulfillment_centers")
}

enum DeliveryAgentStatus {
  ONLINE
  OFFLINE
  AVAILABLE
  ON_DELIVERY
  UNAVAILABLE
}

enum VehicleType {
  BIKE
  CAR
  VAN
  BIKE_ELECTRIC
}

model DeliveryAgent {
  id              String              @id @default(cuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?             @db.VarChar(20)
  vehicleType     VehicleType         @default(BIKE)
  vehicleNumber   String?             @db.VarChar(20)
  licenseNo       String?             @db.VarChar(50)
  currentLat      Decimal?            @db.Decimal(9, 6)
  currentLng      Decimal?            @db.Decimal(9, 6)
  status          DeliveryAgentStatus @default(OFFLINE)
  zoneId          String?
  zone            DeliveryZone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  rating          Decimal             @default(4.5) @db.Decimal(3, 2)
  totalDeliveries Int                 @default(0)
  lastSeenAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  assignments     DeliveryAssignment[]

  @@index([zoneId, status])
  @@index([status])
  @@map("delivery_agents")
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  NEARBY
  DELIVERED
  CANCELLED
}

model DeliveryAssignment {
  id                String            @id @default(cuid())
  orderId           String            @unique
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryAgentId   String
  deliveryAgent     DeliveryAgent     @relation(fields: [deliveryAgentId], references: [id], onDelete: Cascade)
  zoneId            String?
  zone              DeliveryZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  status            DeliveryStatus    @default(ASSIGNED)
  pickupLat         Decimal?          @db.Decimal(9, 6)
  pickupLng         Decimal?          @db.Decimal(9, 6)
  pickupAt          DateTime?
  deliveryLat       Decimal?          @db.Decimal(9, 6)
  deliveryLng       Decimal?          @db.Decimal(9, 6)
  customerLandmark  String?
  deliveredAt       DateTime?
  route             Json?
  notes             String?
  estimatedEta      DateTime?
  actualDuration    Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  trackingEvents    DeliveryTrackingEvent[]

  @@index([orderId])
  @@index([deliveryAgentId, status])
  @@index([status])
  @@map("delivery_assignments")
}

enum TrackingEventType {
  PICKED_UP
  IN_TRANSIT
  NEARBY
  DELIVERED
  EXCEPTION
  LOCATION_UPDATE
}

model DeliveryTrackingEvent {
  id                  String              @id @default(cuid())
  deliveryAssignmentId String
  deliveryAssignment  DeliveryAssignment  @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Cascade)
  eventType           TrackingEventType
  lat                 Decimal?            @db.Decimal(9, 6)
  lng                 Decimal?            @db.Decimal(9, 6)
  message             String              @db.Text
  metadata            Json?
  recordedBy          String?
  createdAt           DateTime            @default(now())

  @@index([deliveryAssignmentId])
  @@index([createdAt])
  @@map("delivery_tracking_events")
}

// ===================== WALLET =====================

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Decimal  @default(0)
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]
  voucherRedemptions VoucherRedemption[]
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTxnType
  amount      Decimal
  currency    String          @default("INR")
  balanceBefore Decimal
  balanceAfter  Decimal
  description String?
  referenceId String?         // orderId, voucherId, etc.
  referenceType String?       // ORDER, VOUCHER, REDEEM, REFUND, CASHBACK, WITHDRAWAL
  regionId    String?
  region      Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([walletId])
  @@index([referenceId, referenceType])
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

// ===================== VOUCHERS =====================

model VoucherTier {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  icon                    String   // icon identifier (e.g., "shopping-voucher")
  description             String?
  color                   String   @default("#2563eb") // hex color for UI
  balanceMode             TierBalanceMode @default(SHARED) // SHARED or SEPARATE
  minPurchasePrice        Decimal?
  maxRedemptionPerOrder   Decimal? @default(100) // max % of order value redeemable
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  regionId                String?
  region                  Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  translations            VoucherTierTranslation[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  vouchers                Voucher[]
  userBalances            VoucherTierBalance[]
  giftCards               GiftCard[]

  @@index([slug])
  @@index([isActive, sortOrder])
  @@index([regionId, isActive, sortOrder])
}

enum TierBalanceMode {
  SHARED   // balance shared across all vouchers in this tier
  SEPARATE // each voucher maintains separate balance (like gift cards)
}

model VoucherTierTranslation {
  id            String   @id @default(cuid())
  voucherTierId String
  voucherTier   VoucherTier @relation(fields: [voucherTierId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  description   String?

  @@unique([voucherTierId, locale])
  @@index([locale])
}

model Voucher {
  id              String          @id @default(cuid())
  code            String          @unique
  codeHash        String?
  encryptedCode   String?
  type            VoucherType     @default(AMOUNT)
  faceValue       Decimal         // original value (₹)
  purchasePrice   Decimal         // what user paid to buy it (₹) — can differ if discount/offer
  denomination    Decimal?        // for AMOUNT type: how much wallet credit per voucher
  redeemRate      Decimal         @default(1) // multiplier: faceValue * redeemRate = wallet credit
  currency        String          @default("INR")
  expiryDays      Int             @default(365)
  validFrom       DateTime        @default(now())
  validUntil      DateTime?
  maxRedemptions  Int?            // total redemption limit
  redeemedCount   Int             @default(0)
  perUserLimit    Int?            // max redemptions per user
  isActive        Boolean         @default(true)
  regionId        String?
  region          Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  voucherTierId   String?
  voucherTier     VoucherTier?    @relation(fields: [voucherTierId], references: [id])
  redemptions     VoucherRedemption[]
  attempts        VoucherAttempt[]

  @@index([voucherTierId])
  @@index([isActive, validFrom, validUntil])
  @@index([regionId, isActive])
}

enum VoucherType {
  AMOUNT       // adds amount to wallet
  PERCENTAGE   // adds percentage of faceValue
  CASHBACK     // cashback voucher
  BONUS        // bonus multiplier voucher
}

model VoucherRedemption {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  voucherCode String
  codeHash    String?
  redemptionToken String? @unique
  voucherTierId String?
  faceValue   Decimal
  redeemRate  Decimal
  creditAmount Decimal  // actual amount credited to wallet
  redeemedAt  DateTime @default(now())

  @@index([userId])
  @@index([voucherId])
  @@index([walletId])
  @@index([codeHash])
  @@index([redemptionToken])
  @@index([voucherTierId])
}

model VoucherAttempt {
  id          String   @id @default(cuid())
  voucherId   String?
  voucher     Voucher?  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  codeHash    String
  userId      String?
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([codeHash])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

// ===================== VOUCHER TIER BALANCES =====================

model VoucherTierBalance {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherTierId   String
  voucherTier     VoucherTier @relation(fields: [voucherTierId], references: [id])
  balance         Decimal  @default(0)
  currency        String   @default("INR")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, voucherTierId])
  @@index([userId])
  @@index([voucherTierId])
}

// ===================== GIFT CARDS =====================

model GiftCard {
  id              String   @id @default(cuid())
  code            String   @unique
  codeHash        String?
  encryptedCode   String?
  tierId          String?
  tier            VoucherTier? @relation(fields: [tierId], references: [id])
  faceValue       Decimal
  balance         Decimal
  currency        String   @default("INR")
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  redeemedCount   Int      @default(0)
  totalRedeemed   Decimal  @default(0)
  regionId        String?
  region          Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    GiftCardTransaction[]
  giftCardOrders  GiftCardOrder[]

  @@index([codeHash])
  @@index([tierId])
  @@index([isActive, validFrom, validUntil])
  @@index([regionId, isActive])
}

model GiftCardTransaction {
  id             String   @id @default(cuid())
  giftCardId     String
  giftCard       GiftCard @relation(fields: [giftCardId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  orderId        String?
  type           GiftCardTxnType
  amount         Decimal
  balanceBefore  Decimal
  balanceAfter   Decimal
  referenceId    String?
  referenceType  String?
  createdAt      DateTime @default(now())

  @@index([giftCardId])
  @@index([userId])
  @@index([orderId])
}

enum GiftCardTxnType {
  CREDIT
  DEBIT
  ADJUSTMENT
  EXPIRY
}

// ===================== GIFT CARD STORE =====================

enum GiftCardDeliveryType {
  E_GIFT
  PHYSICAL
}

enum GiftCardFormat {
  STANDARD
  ANIMATED
  PHOTO
}

model GiftCardOccasion {
  id          String   @id @default(cuid())
  name        String   @unique // "Birthday", "Wedding", "Anniversary"
  slug        String   @unique
  icon        String?  // emoji or icon path
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeCards  GiftCardStore[]

  @@index([slug, isActive])
  @@index([sortOrder])
  @@map("gift_card_occasions")
}

model GiftCardRecipientType {
  id          String   @id @default(cuid())
  name        String   @unique // "For Him", "For Her", "Mother", "Father"
  slug        String   @unique
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeCards  GiftCardStore[]

  @@index([slug, isActive])
  @@index([sortOrder])
  @@map("gift_card_recipient_types")
}

model GiftCardDesign {
  id          String   @id @default(cuid())
  name        String   @unique // "Birthday Gift Box", "Pink Festive", "Black Card"
  slug        String   @unique
  imageUrl    String   // preview image
  themeColor  String?  // "pink", "black", "festive", "minimal"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeCards  GiftCardStore[]

  @@index([slug, isActive])
  @@map("gift_card_designs")
}

model GiftCardStore {
  id              String   @id @default(cuid())
  name            String   // "Birthday Wishes Gift Card"
  slug            String   @unique
  description     String?
  imageUrl        String   // main card image
  images          Json?    // additional card images

  // Pricing
  minAmount       Decimal
  maxAmount       Decimal
  fixedAmounts    Decimal[] // preset denominations: [500, 1000, 2000]
  customAmount    Boolean  @default(true)

  // Delivery
  deliveryTypes   String   @default("E_GIFT") // "E_GIFT,PHYSICAL"
  format          GiftCardFormat @default(STANDARD)

  // Sorting & Discovery
  isBestseller    Boolean  @default(false)
  isNewArrival    Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  viewCount       Int      @default(0)

  // Metadata (stored as string for filtering; actual lookup via relations or JSON)
  seller          String?  // "Amazon", "PineLabs", "GyFTR"
  brand           String?  // for brand gift cards
  categories      String?  // comma-separated: "Clothing,Electronics,Beauty"
  languages       String?  // "English,Hindi"
  countryOfOrigin String   @default("IN")

  // Relations
  designId        String?
  design          GiftCardDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)
  occasions       GiftCardOccasion[]
  recipients      GiftCardRecipientType[]
  orders          GiftCardOrder[]

  // Visibility
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug, isActive])
  @@index([isBestseller, isActive])
  @@index([isNewArrival, isActive])
  @@index([isFeatured, isActive])
  @@index([seller, isActive])
  @@index([sortOrder])
  @@map("gift_card_store")
}

model GiftCardOrder {
  id              String   @id @default(cuid())
  storeCardId     String
  storeCard       GiftCardStore @relation(fields: [storeCardId], references: [id])
  giftCardId      String?
  giftCard        GiftCard? @relation(fields: [giftCardId], references: [id])

  buyerId         String?
  buyer           User?    @relation("GiftCardBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  recipientEmail  String?
  recipientPhone  String?
  recipientName   String?
  message         String?

  amount          Decimal
  currency        String  @default("INR")

  deliveryType    GiftCardDeliveryType
  scheduledDate   DateTime?

  orderNo         String  @unique
  status          OrderStatus @default(PENDING)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([buyerId])
  @@index([storeCardId])
  @@index([giftCardId])
  @@index([orderNo])
  @@index([status])
  @@map("gift_card_orders")
}

