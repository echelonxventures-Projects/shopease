model ProductOptionType {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  label     String?
  sortOrder Int      @default(0)
  values    ProductOptionValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_option_types")
}

model ProductOptionValue {
  id           String   @id @default(cuid())
  optionTypeId String
  optionType   ProductOptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  value        String
  hexColor     String?
  image        String?
  sortOrder    Int      @default(0)
  variants     VariantOptionValue[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([optionTypeId, value])
  @@index([optionTypeId])
  @@map("product_option_values")
}

model ProductVariant {
  id            String     @id @default(cuid())
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?
  isDefault     Boolean    @default(false)
  price         Decimal
  comparePrice  Decimal?
  discountType  DiscountType @default(NONE)
  discountValue Decimal?
  stock         Int        @default(0)
  weight        String?
  images        String[]
  isActive      Boolean    @default(true)
  barcodes      String[]
  hsCode        String?
  trackingType  ProductTrackingType @default(NONE)
  expiryDays    Int?

  // International variant fields
  gtin              String?
  mpn               String?
  condition         ProductCondition @default(NEW)
  costPrice         Decimal?
  wholesalePrice    Decimal?
  mapPrice          Decimal?
  weightGrams       Decimal?
  lengthMm          Decimal?
  widthMm           Decimal?
  heightMm          Decimal?
  color             String?
  colorHex          String?
  size              String?
  material          String?
  packSize          Int?
  minOrderQty       Int?       @default(1)
  maxOrderQty       Int?
  leadTimeDays      Int?
  countryOfOrigin   String?

  options       VariantOptionValue[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@index([sku])
  @@index([gtin])
  @@map("product_variants")
}

model VariantOptionValue {
  id            String             @id @default(cuid())
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model Inventory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantity   Int      @default(0)
  reserved   Int      @default(0)
  lowStock   Int      @default(5)
  avgCost    Decimal  @default(0)
  updatedAt  DateTime @default(now())

  inventoryLogs InventoryLog[]

  @@unique([productId, supplierId, locationId])
  @@index([productId])
  @@index([supplierId])
  @@index([locationId])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type          String
  quantity      Int
  reference     String?
  referenceType String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ===================== SUPPLIERS =====================

model Supplier {
  id                    String                      @id @default(cuid())
  name                  String
  code                  String                      @unique
  uniqueId              String?                     @unique @default(cuid()) @map("supplierUniqueId")
  contactPerson         String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  zipCode               String?
  gstin                 String?
  taxId                 String?
  paymentTerms          String?
  notes                 String?
  isActive              Boolean                     @default(true)

  // Country linkage
  countryId             String?
  countryLoc            Location?                   @relation("SupplierCountry", fields: [countryId], references: [id], onDelete: SetNull)
  stateId               String?
  stateLoc              Location?                   @relation("SupplierState", fields: [stateId], references: [id], onDelete: SetNull)

  // ID verification
  idType                SupplierIdType              @default(TAX_ID)
  verificationStatus    SupplierVerificationStatus  @default(PENDING)
  verifiedById          String?
  verifiedBy            User?                       @relation("VerifiedSuppliers", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  verificationNotes     String?

  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  inventoryItems        Inventory[]
  purchaseOrders        PurchaseOrder[]
  stockMovements        StockMovement[]
  productSuppliers      ProductSupplier[]
  supplierListings      SupplierProductListing[]
  returns               SupplierReturn[]
  inventoryLogs         InventoryLog[]
  serialLotTracking     SerialLotTracking[]

  @@index([code])
  @@index([isActive])
  @@index([uniqueId])
  @@index([verificationStatus])
  @@map("suppliers")
}

enum SupplierIdType {
  GSTIN         // India: Goods & Services Tax ID (15 chars)
  PAN           // India: Permanent Account Number (10 chars)
  EIN           // US: Employer Identification Number (XX-XXXXXXX)
  VAT           // EU/UK: Value Added Tax Number
  ABN           // Australia: Australian Business Number (11 digits)
  SST           // Malaysia/Indonesia: Sales & Service Tax
  BUSINESS_REG  // General: Business Registration Number
  TAX_ID        // Generic: Tax ID
  OTHER         // Custom: other ID type
}

enum SupplierVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model ProductSupplier {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku  String?
  costPrice    Decimal?
  leadTimeDays Int?
  isPreferred  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// ===================== PRODUCT MASTER CATALOG & SUPPLIER LISTING =====================

model SupplierProductListing {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  listingSku      String?
  listingPrice    Decimal  // supplier's selling price to customers
  comparePrice    Decimal? // MRP / original price for discount display
  quantity        Int      @default(0)
  status          String   @default("DRAFT") // DRAFT, ACTIVE, INACTIVE, OUT_OF_STOCK, REJECTED
  isFeatured      Boolean  @default(false)
  shippingWeight  Decimal? // kg
  shippingLength  Decimal? // cm
  shippingWidth   Decimal? // cm
  shippingHeight  Decimal? // cm
  tags            String[]
  extraImages     String[]
  description     String?  // supplier-specific product description
  keywords        String[]
  enabledAt       DateTime?
  disabledAt      DateTime?
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([supplierId, status])
  @@index([productId, status])
  @@index([status])
  @@map("supplier_listings")
}

// ===================== PURCHASE ORDERS =====================

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  poNumber        String               @unique
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  locationId      String?
  location        Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status          PurchaseOrderStatus  @default(DRAFT)
  items           PurchaseOrderItem[]
  returns         SupplierReturn[]
  subtotal        Decimal              @default(0)
  tax             Decimal              @default(0)
  total           Decimal              @default(0)
  expectedDate    DateTime?
  receivedDate    DateTime?
  notes           String?
  approvedById    String?
  approvedBy      User?          @relation("PurchaseOrderApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  approvalNotes   String?
  sentDate        DateTime?
  createdBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  sentQuantity     Int      @default(0)
  receivedQuantity Int      @default(0)
  returnQuantity   Int      @default(0)
  unitPrice        Decimal
  subtotal         Decimal
  notes            String?

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ===================== INVENTORY LOGS =====================

enum InventoryLogType {
  PURCHASE_RECEIPT
  SALE_DEDUCTION
  RETURN
  ADJUSTMENT
  TRANSFER
  INITIAL
}

model InventoryLog {
  id              String           @id @default(cuid())
  inventoryId     String
  inventory       Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type            InventoryLogType
  quantity        Int              // delta (positive = added, negative = removed)
  beforeQuantity  Int
  afterQuantity   Int
  referenceId     String?
  referenceType   String?          // "PURCHASE_ORDER", "RETURN", "ORDER_FULFILLMENT", "ADJUSTMENT", etc.
  reference       String?          // human-readable: PO number, return number, etc.
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([inventoryId])
  @@index([productId])
  @@index([supplierId])
  @@index([locationId])
  @@index([type])
  @@index([referenceId, referenceType])
  @@index([createdAt])
  @@index([userId])
  @@map("inventory_logs")
}

// Add InventoryLog relation to Inventory
// (handled automatically by the inventoryId relation field above)

// ===================== SUPPLIER RETURNS =====================

enum ReturnStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SHIPPED
  COMPLETED
  CANCELLED
}

model SupplierReturn {
  id                    String        @id @default(cuid())
  returnNumber          String        @unique  // "RET-XXXXXX"
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId            String
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  status                ReturnStatus  @default(DRAFT)
  items                 SupplierReturnItem[]
  reason                String?
  approvedById          String?
  approvedBy            User?         @relation("ReturnApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  approvalNotes         String?
  shippedDate           DateTime?
  receivedBySupplierDate DateTime?
  createdBy             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([returnNumber])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id               String          @id @default(cuid())
  supplierReturnId String
  supplierReturn   SupplierReturn  @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Decimal
  subtotal         Decimal
  notes            String?

  @@index([supplierReturnId])
  @@index([productId])
  @@map("supplier_return_items")
}

// ===================== CART =====================

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int      @default(1)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
}

// ===================== ORDERS =====================

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  items           Json
  subtotal        Decimal
  tax             Decimal       @default(0)
  shippingCost    Decimal       @default(0)
  discount        Decimal       @default(0)
  total           Decimal
  shippingAddress Json
  paymentMethod   String?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntent   String?
  trackingCode    String?
  notes           String?
  couponCode      String?
  orderNotes      String?        // Customer order notes/instructions
  metadata        Json?          // picking/packing workflow + substitution state
  isGift          Boolean        @default(false)
  giftMessage     String?
  giftWrapFee     Decimal        @default(0)
  deliverySlotId  String?
  deliverySlot    DeliverySlot?  @relation(fields: [deliverySlotId], references: [id])
  isExpress       Boolean        @default(false)
  expressFee      Decimal        @default(0)
  codFee          Decimal        @default(0)
  isGuestOrder    Boolean        @default(false)
  guestEmail      String?
  shareToken      String?        @unique
  idempotencyKey  String?        @unique  // Prevents double-submit
  regionId        String?
  region          Region?       @relation(fields: [regionId], references: [id])
  currency        String        @default("INR")
  siteId          String?
  site            Site?         @relation(fields: [siteId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments        Payment[]
  transactions    PaymentTransaction[]
  statusHistory   OrderStatusHistory[]
  refunds         Refund[]
  deliveryAssignment DeliveryAssignment?
  sellerOrders    SellerOrder[]
  bnplOrder       BNPLOrder?
  splitPayment    SplitPayment?
  returnRequests  ReturnRequest[]
  b2bOrder        B2BOrder?
  deliveryFeedback DeliveryFeedback?

  @@index([userId, status])
  @@index([orderNumber])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([siteId, status])
  @@index([regionId, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  amount         Decimal
  method         String
  status         PaymentStatus  @default(PENDING)
  transactionId  String?
  metadata       Json?
  createdAt      DateTime       @default(now())
}

model Refund {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Decimal
  reason    String
  status    RefundStatus  @default(PENDING)
  method    String?
  processedAt DateTime?
  adminNote String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// ===================== REVIEWS =====================

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  images      String[]
  isVerified  Boolean  @default(false)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | FLAGGED
  moderationNote String?
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id])
  helpfulVotes    Int      @default(0)
  reviewVotes     ReviewVote[]
  videoReviews    VideoReview[]
  createdAt       DateTime @default(now())

  @@unique([userId, productId, variantId])
  @@index([productId, rating])
  @@index([status])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@map("review_votes")
}

// ===================== PRODUCT Q&A =====================

model ProductQuestion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  question  String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  answers   ProductAnswer[]
  @@index([productId])
  @@map("product_questions")
}

model ProductAnswer {
  id           String   @id @default(cuid())
  questionId   String
  question     ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId       String?
  isSeller     Boolean  @default(false)
  answer       String
  createdAt    DateTime @default(now())

  @@index([questionId])
  @@map("product_answers")
}

// ===================== PRICE HISTORY =====================

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal
  oldPrice  Decimal?
  regionId  String?
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("price_history")
}

// ===================== PRICE DROP ALERTS =====================

model PriceDropAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Decimal
  triggeredAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, productId])
  @@map("price_drop_alerts")
}

// ===================== DAILY DEALS =====================

model DailyDeal {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType String   @default("PERCENTAGE") // PERCENTAGE | FLAT
  discountValue Decimal
  dealDate     DateTime
  bannerImage  String?
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

