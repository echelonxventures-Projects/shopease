// ===================== STREAMING / NETFLIX-LIKE SERVICE =====================

enum StreamingContentType {
  MOVIE
  SERIES
  EPISODE
  DOCUMENTARY
  SHORT
  LIVE
  MUSIC_VIDEO
  PODCAST
}

enum StreamingQuality {
  SD
  HD
  FULL_HD
  UHD_4K
  DOLBY_VISION
}

model StreamingConfig {
  id                    String   @id @default(cuid())
  enabled               Boolean  @default(false)
  brandName             String   @default("Neoflix")
  tagline               String?
  logoUrl               String?
  heroImageUrl          String?
  maxConcurrentStreams   Int      @default(1)
  maxProfiles           Int      @default(5)
  trialDays             Int      @default(7)
  downloadEnabled       Boolean  @default(false)
  maxDownloads          Int      @default(10)
  adSupportedTier       Boolean  @default(false)
  parentalControlEnabled Boolean @default(true)
  contentRatings        String[] @default(["U", "UA", "A", "S"])
  supportedQualities    StreamingQuality[] @default([SD, HD, FULL_HD])
  supportedLanguages    String[] @default(["en", "hi"])
  autoPlayNext          Boolean  @default(true)
  skipIntroEnabled      Boolean  @default(true)
  skipIntroDuration     Int      @default(120)  // seconds — skip intro jumps to this point
  skipRecapDuration     Int      @default(30)   // seconds — recap ends at this point
  watchPartyEnabled     Boolean  @default(false)
  offlineViewingDays    Int      @default(30)
  // ── Configurable Algorithms ──
  trendingWindowDays    Int      @default(7)    // "trending" = most watched in N days
  newPopularWindowDays  Int      @default(30)   // "new & popular" = released in last N days
  topNTrending          Int      @default(10)   // show top N trending items
  recommendationLimit   Int      @default(20)   // max recommendations to show
  continueWatchingLimit Int      @default(10)   // max continue watching items
  watchHistoryLimit     Int      @default(50)   // max watch history items
  // ── Playback ──
  playbackSpeeds        String[] @default(["0.5", "0.75", "1", "1.25", "1.5", "2"])
  defaultQuality        StreamingQuality @default(HD)
  // ── Content Discovery ──
  enableGeoRestrictions Boolean  @default(false)
  enableKidsMode        Boolean  @default(true)
  maturityLevels        String[] @default(["U", "U/A 7+", "U/A 13+", "U/A 16+", "A"])
  // ── Notifications ──
  enableEmailNotifications Boolean @default(false)
  enablePushNotifications  Boolean @default(false)
  // ── Extensible JSON config for anything else ──
  extraConfig           Json?    // unlimited key-value pairs for future features
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("streaming_config")
}

model StreamingPlan {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  description         String?
  price               Float
  currency            String            @default("INR")
  interval            String            @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  maxStreams           Int               @default(1)
  maxProfiles         Int               @default(1)
  quality             StreamingQuality  @default(HD)
  downloadAllowed     Boolean           @default(false)
  adsEnabled          Boolean           @default(false)
  features            String[]          @default([])
  options             Json?             // Infinite configurable key-value pairs (e.g. {"HDR": "true", "Spatial Audio": "Dolby Atmos", "Family Sharing": "5 members"})
  isActive            Boolean           @default(true)
  sortOrder           Int               @default(0)
  trialDays           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  subscriptions       StreamingSubscription[]

  @@index([isActive, sortOrder])
  @@map("streaming_plans")
}

model StreamingSubscription {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  plan            StreamingPlan @relation(fields: [planId], references: [id])
  status          String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, EXPIRED, TRIAL
  startDate       DateTime @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  autoRenew       Boolean  @default(true)
  paymentMethod   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, planId])
  @@index([userId, status])
  @@index([status, endDate])
  @@map("streaming_subscriptions")
}

model StreamingContent {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  type            StreamingContentType
  description     String?
  thumbnailUrl    String?
  bannerUrl       String?
  trailerUrl      String?
  videoUrl        String?             // Main content URL (HLS/DASH)
  duration        Int?                // seconds
  releaseDate     DateTime?
  rating          String?             // U, UA, A, S
  imdbRating      Float?
  language        String              @default("en")
  subtitles       String[]            @default([])
  genres          String[]            @default([])
  cast            String[]            @default([])
  director        String?
  producer        String?
  studio          String?
  seasonNumber    Int?
  episodeNumber   Int?
  seriesId        String?
  series          StreamingContent?   @relation("SeriesEpisodes", fields: [seriesId], references: [id])
  episodes        StreamingContent[]  @relation("SeriesEpisodes")
  quality         StreamingQuality[]  @default([HD])
  isFeatured      Boolean             @default(false)
  isExclusive     Boolean             @default(false)
  isActive        Boolean             @default(true)
  viewCount       Int                 @default(0)
  tags            String[]            @default([])
  maturityRating  String?             @default("U")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  watchHistory    WatchHistory[]
  watchlist       StreamingWatchlist[]
  ratings         StreamingRating[]
  collectionItems StreamingCollectionItem[]
  downloads       StreamingDownload[]

  @@index([type, isActive])
  @@index([genres])
  @@index([language, isActive])
  @@index([isFeatured])
  @@index([seriesId, seasonNumber, episodeNumber])
  @@map("streaming_content")
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  content     StreamingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  progress    Int      @default(0) // seconds watched
  completed   Boolean  @default(false)
  lastWatched DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, lastWatched])
  @@map("watch_history")
}

model StreamingWatchlist {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  content   StreamingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId])
  @@map("streaming_watchlist")
}

// ── Streaming Profiles (Netflix multi-profile)
model StreamingProfile {
  id             String   @id @default(cuid())
  userId         String
  name           String
  avatarUrl      String?
  isKids         Boolean  @default(false)
  maturityRating String   @default("U/A 16+") // U, U/A 7+, U/A 13+, U/A 16+, A
  pin            String?  // 4-digit parental lock
  language       String   @default("en")
  autoPlayNext   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("streaming_profiles")
}

// ── Streaming Ratings & Reviews
model StreamingRating {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  content   StreamingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5 stars
  review    String?
  spoiler   Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([contentId, rating])
  @@map("streaming_ratings")
}

// ── Streaming Collections (Trending, Top 10, Genre-based)
model StreamingCollection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  type        String   @default("MANUAL") // MANUAL, TRENDING, TOP_10, NEW_RELEASES, GENRE, PERSONALIZED
  genre       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  items       StreamingCollectionItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
  @@map("streaming_collections")
}

model StreamingCollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  collection   StreamingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentId    String
  content      StreamingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  sortOrder    Int      @default(0)

  @@unique([collectionId, contentId])
  @@map("streaming_collection_items")
}

// ── Streaming Notifications
model StreamingNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // NEW_RELEASE, RECOMMENDATION, SUBSCRIPTION, REMINDER
  title     String
  message   String
  imageUrl  String?
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("streaming_notifications")
}

// ── Streaming Downloads
model StreamingDownload {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  content   StreamingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  quality   StreamingQuality @default(HD)
  status    String   @default("DOWNLOADING") // DOWNLOADING, COMPLETED, EXPIRED, DELETED
  expiresAt DateTime
  fileSize  Int?     // bytes
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  @@index([userId, status])
  @@map("streaming_downloads")
}

// ===================== TRADING PLATFORM (Groww/Zerodha-like) =====================

// ── Global Exchanges & Market Types ─────────────────────────────────────────

model TradingExchange {
  id            String   @id @default(cuid())
  code          String   @unique  // "NSE", "NYSE", "LSE", etc.
  name          String            // "National Stock Exchange of India"
  country       String            // "IN", "US", "GB"
  region        String            // "ASIA", "AMERICAS", "EUROPE", "AFRICA", "OCEANIA", "MIDDLE_EAST"
  timezone      String            // "Asia/Kolkata", "America/New_York"
  currency      String            // "INR", "USD", "GBP"
  marketType    String            // "EQUITY", "COMMODITY", "DERIVATIVES", "CRYPTO", "FOREX", "BOND"
  openTime      String?           // "09:15" (local time)
  closeTime     String?           // "15:30"
  preMarketOpen String?
  postMarketClose String?
  tradingDays   String[]  @default(["MON", "TUE", "WED", "THU", "FRI"])
  isActive      Boolean  @default(true)
  logoUrl       String?
  website       String?
  mic           String?  // Market Identifier Code (ISO 10383)
  suffix        String?  // Yahoo Finance suffix e.g. ".NS", ".L", ".T"
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([country])
  @@index([region, isActive])
  @@index([marketType])
  @@map("trading_exchanges")
}


enum TradingAssetType {
  STOCK
  ETF
  MUTUAL_FUND
  BOND
  COMMODITY
  CRYPTO
  FOREX
  FUTURES
  OPTIONS
  INDEX
  IPO
  SGB // Sovereign Gold Bond
  NPS
  FD  // Fixed Deposit
}

enum TradingOrderType {
  MARKET
  LIMIT
  STOP_LOSS
  STOP_LIMIT
  BRACKET
  COVER
  AMO // After Market Order
  GTT // Good Till Triggered
}

enum TradingOrderSide {
  BUY
  SELL
}

enum TradingOrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
  TRIGGERED
}

model TradingConfig {
  id                      String   @id @default(cuid())
  enabled                 Boolean  @default(false)
  brandName               String   @default("Newtrade")
  tagline                 String?
  logoUrl                 String?
  // Supported asset classes
  stocksEnabled           Boolean  @default(true)
  mutualFundsEnabled      Boolean  @default(true)
  etfEnabled              Boolean  @default(true)
  cryptoEnabled           Boolean  @default(false)
  forexEnabled            Boolean  @default(false)
  commoditiesEnabled      Boolean  @default(false)
  futuresEnabled          Boolean  @default(false)
  optionsEnabled          Boolean  @default(false)
  ipoEnabled              Boolean  @default(true)
  bondsEnabled            Boolean  @default(true)
  sgbEnabled              Boolean  @default(true)
  npsEnabled              Boolean  @default(false)
  fdEnabled               Boolean  @default(false)
  // Trading hours & rules
  marketOpenTime          String   @default("09:15")
  marketCloseTime         String   @default("15:30")
  preMarketOpen           String   @default("09:00")
  preMarketClose          String   @default("09:15")
  postMarketOpen          String   @default("15:40")
  postMarketClose         String   @default("16:00")
  tradingDays             String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  // Fees & charges
  brokerageFlat           Decimal  @default(20)    // per order flat fee
  brokeragePercent        Decimal  @default(0.03)  // percentage of trade value
  brokerageType           String   @default("FLAT") // FLAT, PERCENT, HYBRID
  sttRate                 Decimal  @default(0.1)   // Securities Transaction Tax %
  gstRate                 Decimal  @default(18)    // GST on brokerage
  stampDutyRate           Decimal  @default(0.015)
  sebiCharges             Decimal  @default(0.0001)
  exchangeCharges         Decimal  @default(0.00345)
  dpCharges               Decimal  @default(15.93) // per sell transaction
  // Limits
  maxOrderValue           Decimal  @default(10000000) // 1 crore
  maxDailyOrders          Int      @default(100)
  maxOpenOrders           Int      @default(25)
  marginMultiplier        Decimal  @default(5)     // leverage for intraday
  // Features
  sipEnabled              Boolean  @default(true)  // Systematic Investment Plan
  gttEnabled              Boolean  @default(true)  // Good Till Triggered
  basketOrderEnabled      Boolean  @default(true)
  paperTradingEnabled     Boolean  @default(true)
  fractionalSharesEnabled Boolean  @default(false)
  afterMarketOrderEnabled Boolean  @default(true)
  intradayEnabled         Boolean  @default(true)
  shortSellingEnabled     Boolean  @default(false)
  // KYC & compliance
  kycRequired             Boolean  @default(true)
  panRequired             Boolean  @default(true)
  aadhaarRequired         Boolean  @default(false)
  nomineeRequired         Boolean  @default(true)
  riskDisclosureRequired  Boolean  @default(true)
  // Notifications
  orderNotifications      Boolean  @default(true)
  priceAlerts             Boolean  @default(true)
  marketNewsEnabled       Boolean  @default(true)
  // Data providers
  marketDataProvider      String   @default("INTERNAL") // INTERNAL, NSE, BSE, YAHOO, ALPHA_VANTAGE
  marketDataApiKey        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("trading_config")
}

model TradingAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  accountNumber   String   @unique
  status          String   @default("PENDING") // PENDING, ACTIVE, SUSPENDED, CLOSED
  kycStatus       String   @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  panNumber       String?
  dematId         String?  // Demat account number
  bankAccountId   String?
  bankIfsc        String?
  nomineeDetails  Json?
  riskProfile     String   @default("MODERATE") // CONSERVATIVE, MODERATE, AGGRESSIVE
  marginAvailable Decimal  @default(0)
  fundsBalance    Decimal  @default(0)
  blockedMargin   Decimal  @default(0)
  isPaperTrading  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  holdings        TradingHolding[]
  orders          TradingOrder[]
  watchlists      TradingWatchlist[]
  sipPlans        TradingSIP[]
  transactions    TradingTransaction[]
  gttOrders       TradingGTT[]
  ipoApplications TradingIPOApplication[]
  mfInvestments   TradingMFInvestment[]
  alerts          TradingAlert[]
  positions       TradingPosition[]
  algoStrategies  AlgoStrategy[]
  brokerConnections AlgoBrokerConnection[]

  @@index([userId])
  @@index([status])
  @@map("trading_accounts")
}

model TradingAsset {
  id              String           @id @default(cuid())
  symbol          String           @unique
  name            String
  type            TradingAssetType
  exchange        String           @default("NSE") // NSE, BSE, MCX, CRYPTO
  sector          String?
  industry        String?
  isin            String?          @unique
  lotSize         Int              @default(1)
  tickSize        Decimal          @default(0.05)
  circuitLimit    Decimal?         // percentage
  faceValue       Decimal?
  marketCap       Decimal?
  peRatio         Decimal?
  pbRatio         Decimal?
  dividendYield   Decimal?
  week52High      Decimal?
  week52Low       Decimal?
  isActive        Boolean          @default(true)
  isTradeable     Boolean          @default(true)
  isF_O           Boolean          @default(false) // Futures & Options eligible
  logoUrl         String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  holdings        TradingHolding[]
  orders          TradingOrder[]
  watchlistItems  TradingWatchlistItem[]
  marketData      TradingMarketData[]
  sipPlans        TradingSIP[]
  gttOrders       TradingGTT[]
  alerts          TradingAlert[]
  positions       TradingPosition[]
  orderDepth      TradingOrderDepth?

  @@index([type, isActive])
  @@index([exchange, symbol])
  @@index([sector])
  @@map("trading_assets")
}

model TradingMarketData {
  id          String   @id @default(cuid())
  assetId     String
  asset       TradingAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ltp         Decimal  // Last Traded Price
  open        Decimal?
  high        Decimal?
  low         Decimal?
  close       Decimal? // Previous close
  volume      BigInt   @default(0)
  change      Decimal  @default(0)
  changePct   Decimal  @default(0)
  bid         Decimal?
  ask         Decimal?
  bidQty      Int?
  askQty      Int?
  timestamp   DateTime @default(now())

  @@index([assetId, timestamp])
  @@map("trading_market_data")
}

model TradingOrder {
  id              String             @id @default(cuid())
  accountId       String
  account         TradingAccount     @relation(fields: [accountId], references: [id])
  assetId         String
  asset           TradingAsset       @relation(fields: [assetId], references: [id])
  orderType       TradingOrderType
  side            TradingOrderSide
  status          TradingOrderStatus @default(PENDING)
  quantity        Int
  filledQuantity  Int                @default(0)
  price           Decimal?           // limit price
  triggerPrice    Decimal?           // stop-loss trigger
  avgFilledPrice  Decimal?
  product         String             @default("CNC") // CNC (delivery), MIS (intraday), NRML
  validity        String             @default("DAY") // DAY, IOC, GTC, GTT
  isAMO           Boolean            @default(false)
  tag             String?            // user tag for identification
  brokerage       Decimal            @default(0)
  taxes           Decimal            @default(0)
  totalCharges    Decimal            @default(0)
  rejectionReason String?
  filledAt        DateTime?
  cancelledAt     DateTime?
  expiresAt       DateTime?
  parentOrderId   String?            // for bracket/cover orders
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([accountId, status])
  @@index([assetId])
  @@index([status, createdAt])
  @@map("trading_orders")
}

model TradingHolding {
  id              String       @id @default(cuid())
  accountId       String
  account         TradingAccount @relation(fields: [accountId], references: [id])
  assetId         String
  asset           TradingAsset @relation(fields: [assetId], references: [id])
  quantity        Int
  avgBuyPrice     Decimal
  investedValue   Decimal
  currentValue    Decimal      @default(0)
  pnl             Decimal      @default(0)
  pnlPercent      Decimal      @default(0)
  dayChange       Decimal      @default(0)
  dayChangePct    Decimal      @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([accountId, assetId])
  @@index([accountId])
  @@map("trading_holdings")
}

model TradingWatchlist {
  id          String   @id @default(cuid())
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  name        String   @default("My Watchlist")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  items       TradingWatchlistItem[]

  @@index([accountId])
  @@map("trading_watchlists")
}

model TradingWatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  watchlist   TradingWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  assetId     String
  asset       TradingAsset @relation(fields: [assetId], references: [id])
  sortOrder   Int      @default(0)
  addedAt     DateTime @default(now())

  @@unique([watchlistId, assetId])
  @@map("trading_watchlist_items")
}

model TradingSIP {
  id            String       @id @default(cuid())
  accountId     String
  account       TradingAccount @relation(fields: [accountId], references: [id])
  assetId       String
  asset         TradingAsset @relation(fields: [assetId], references: [id])
  amount        Decimal
  frequency     String       @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  sipDate       Int          @default(1) // day of month
  status        String       @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  startDate     DateTime     @default(now())
  endDate       DateTime?
  totalInvested Decimal      @default(0)
  installments  Int          @default(0)
  nextDueDate   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([accountId, status])
  @@map("trading_sips")
}

model TradingTransaction {
  id          String       @id @default(cuid())
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  type        String       // DEPOSIT, WITHDRAWAL, BUY, SELL, DIVIDEND, BROKERAGE, TAX, SIP
  amount      Decimal
  balanceBefore Decimal
  balanceAfter  Decimal
  description String?
  referenceId String?      // orderId, sipId, etc.
  status      String       @default("COMPLETED")
  createdAt   DateTime     @default(now())

  @@index([accountId, createdAt])
  @@index([type])
  @@map("trading_transactions")
}

// ── GTT Orders (Good Till Triggered)
model TradingGTT {
  id          String   @id @default(cuid())
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  assetId     String
  asset       TradingAsset @relation(fields: [assetId], references: [id])
  triggerType String   // SINGLE, OCO (One Cancels Other)
  triggerPrice Decimal
  limitPrice  Decimal?
  stopPrice   Decimal? // for OCO
  side        TradingOrderSide
  quantity    Int
  status      String   @default("ACTIVE") // ACTIVE, TRIGGERED, CANCELLED, EXPIRED
  triggeredAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, status])
  @@map("trading_gtt")
}

// ── IPO Applications
model TradingIPO {
  id            String   @id @default(cuid())
  name          String
  symbol        String
  exchange      String   @default("NSE")
  priceMin      Decimal
  priceMax      Decimal
  lotSize       Int
  issueSize     Decimal? // in crores
  openDate      DateTime
  closeDate     DateTime
  listingDate   DateTime?
  status        String   @default("UPCOMING") // UPCOMING, OPEN, CLOSED, LISTED
  category      String   @default("MAINBOARD") // MAINBOARD, SME
  description   String?
  rhpUrl        String?  // Red Herring Prospectus
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  TradingIPOApplication[]
  @@index([status, openDate])
  @@map("trading_ipos")
}

model TradingIPOApplication {
  id        String   @id @default(cuid())
  accountId String
  account   TradingAccount @relation(fields: [accountId], references: [id])
  ipoId     String
  ipo       TradingIPO @relation(fields: [ipoId], references: [id])
  lots      Int
  bidPrice  Decimal
  amount    Decimal
  status    String   @default("APPLIED") // APPLIED, ALLOTTED, NOT_ALLOTTED, REFUNDED
  upiId     String?
  createdAt DateTime @default(now())

  @@unique([accountId, ipoId])
  @@map("trading_ipo_applications")
}

// ── Mutual Funds
model TradingMutualFund {
  id            String   @id @default(cuid())
  name          String
  symbol        String   @unique
  category      String   // EQUITY, DEBT, HYBRID, INDEX, ELSS, LIQUID
  subCategory   String?  // Large Cap, Mid Cap, Small Cap, etc.
  amcName       String   // Asset Management Company
  nav           Decimal  @default(0)
  navDate       DateTime?
  expenseRatio  Decimal  @default(0)
  aum           Decimal? // Assets Under Management (crores)
  returns1Y     Decimal?
  returns3Y     Decimal?
  returns5Y     Decimal?
  riskLevel     String   @default("MODERATE") // LOW, MODERATE, HIGH, VERY_HIGH
  minInvestment Decimal  @default(500)
  minSIP        Decimal  @default(500)
  exitLoad      String?
  isActive      Boolean  @default(true)
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  investments   TradingMFInvestment[]
  @@index([category, isActive])
  @@map("trading_mutual_funds")
}

model TradingMFInvestment {
  id        String   @id @default(cuid())
  accountId String
  account   TradingAccount @relation(fields: [accountId], references: [id])
  fundId    String
  fund      TradingMutualFund @relation(fields: [fundId], references: [id])
  type      String   @default("LUMPSUM") // LUMPSUM, SIP
  units     Decimal  @default(0)
  invested  Decimal  @default(0)
  current   Decimal  @default(0)
  sipAmount Decimal?
  sipDate   Int?
  status    String   @default("ACTIVE") // ACTIVE, REDEEMED, PAUSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
  @@map("trading_mf_investments")
}

// ── Price Alerts
model TradingAlert {
  id          String   @id @default(cuid())
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  assetId     String
  asset       TradingAsset @relation(fields: [assetId], references: [id])
  condition   String   // ABOVE, BELOW, PERCENT_CHANGE
  targetPrice Decimal?
  percentChange Decimal?
  status      String   @default("ACTIVE") // ACTIVE, TRIGGERED, CANCELLED
  triggeredAt DateTime?
  createdAt   DateTime @default(now())

  @@index([accountId, status])
  @@map("trading_alerts")
}

// ── Intraday Positions
model TradingPosition {
  id          String   @id @default(cuid())
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  assetId     String
  asset       TradingAsset @relation(fields: [assetId], references: [id])
  product     String   // MIS, NRML
  side        TradingOrderSide
  quantity    Int
  avgPrice    Decimal
  ltp         Decimal  @default(0)
  pnl         Decimal  @default(0)
  isOpen      Boolean  @default(true)
  openedAt    DateTime @default(now())
  closedAt    DateTime?

  @@index([accountId, isOpen])
  @@map("trading_positions")
}

// ── Order Book Depth (market depth snapshots)
model TradingOrderDepth {
  id       String   @id @default(cuid())
  assetId  String
  asset    TradingAsset @relation(fields: [assetId], references: [id])
  bids     Json     // [{price, qty, orders}]
  asks     Json     // [{price, qty, orders}]
  updatedAt DateTime @default(now())

  @@unique([assetId])
  @@map("trading_order_depth")
}

// ===================== PLATFORM MODULE REGISTRY =====================

model PlatformModule {
  id              String   @id @default(cuid())
  slug            String   @unique          // "streaming", "trading", "food-delivery"
  name            String                    // "Streaming Platform"
  description     String?
  icon            String   @default("🧩")   // emoji or icon class
  version         String   @default("1.0.0")
  status          String   @default("DRAFT") // DRAFT, ACTIVE, MAINTENANCE, DEPRECATED
  // Routing
  adminRoute      String                    // "/admin/streaming"
  userRoute       String                    // "/streaming"
  apiPrefix       String?                   // "/api/streaming"
  // Configuration
  configSchema    Json?                     // JSON Schema for module-specific settings
  config          Json?                     // Current config values
  // Access control
  isPublic        Boolean  @default(false)  // accessible without login
  requiredRole    String?                   // minimum role to access admin
  requiredPlan    String?                   // subscription plan required for users
  // Metadata
  category        String   @default("PLATFORM") // PLATFORM, SERVICE, INTEGRATION, ADDON
  author          String   @default("System")
  logoUrl         String?
  bannerUrl       String?
  tags            String[] @default([])
  dependencies    String[] @default([])     // other module slugs this depends on
  // Lifecycle
  installedAt     DateTime @default(now())
  activatedAt     DateTime?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category, status])
  @@map("platform_modules")
}


// ═══════════════════════════════════════════════════════════════════════════════
// ALGO TRADING PLATFORM
// ═══════════════════════════════════════════════════════════════════════════════

enum AlgoStrategyType {
  MOMENTUM
  MEAN_REVERSION
  BREAKOUT
  SCALPING
  ARBITRAGE
  GRID
  DCA // Dollar Cost Averaging
  PAIRS
  MARKET_MAKING
  TREND_FOLLOWING
  OPTIONS_STRATEGY
  CUSTOM
}

enum AlgoTimeframe {
  TICK
  M1
  M5
  M15
  M30
  H1
  H4
  D1
  W1
  MO1
}

enum AlgoStatus {
  DRAFT
  BACKTESTING
  PAPER_TRADING
  LIVE
  PAUSED
  STOPPED
  ERROR
}

enum AlgoSignalType {
  ENTRY_LONG
  ENTRY_SHORT
  EXIT_LONG
  EXIT_SHORT
  SCALE_IN
  SCALE_OUT
  STOP_LOSS
  TAKE_PROFIT
}

enum AlgoExecutionStatus {
  PENDING
  SUBMITTED
  FILLED
  PARTIALLY_FILLED
  REJECTED
  CANCELLED
  FAILED
}

model AlgoStrategy {
  id              String           @id @default(cuid())
  accountId       String
  account         TradingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  type            AlgoStrategyType
  status          AlgoStatus       @default(DRAFT)
  // Target assets
  symbols         String[]         // symbols this strategy trades
  exchanges       String[]         @default(["NSE"])
  assetTypes      String[]         @default(["STOCK"])
  // Strategy configuration (JSON-based for flexibility)
  indicators      Json             @default("[]")   // [{type:"RSI",period:14,overbought:70,oversold:30}]
  entryConditions Json             @default("[]")   // [{indicator:"RSI",operator:"<",value:30,logic:"AND"}]
  exitConditions  Json             @default("[]")
  parameters      Json             @default("{}")   // strategy-specific params
  // Timeframe
  timeframe       AlgoTimeframe    @default(M5)
  // Risk management
  maxPositionSize Decimal          @default(100000) // max capital per trade
  maxDailyLoss    Decimal          @default(5000)   // stop trading if daily loss exceeds
  maxDrawdown     Decimal          @default(10)     // % max drawdown before pause
  stopLossPct     Decimal?                          // default SL %
  takeProfitPct   Decimal?                          // default TP %
  trailingStopPct Decimal?
  maxOpenTrades   Int              @default(5)
  riskPerTrade    Decimal          @default(2)      // % of capital risked per trade
  // Execution settings
  orderType       String           @default("MARKET") // MARKET, LIMIT
  slippage        Decimal          @default(0.1)    // % acceptable slippage
  cooldownSeconds Int              @default(60)     // min seconds between trades
  // Schedule
  scheduleEnabled Boolean          @default(false)
  scheduleCron    String?                           // cron expression
  scheduleStart   String?                           // HH:mm market start
  scheduleEnd     String?                           // HH:mm market end
  activeDays      String[]         @default(["MON", "TUE", "WED", "THU", "FRI"])
  // Performance
  totalTrades     Int              @default(0)
  winRate         Decimal          @default(0)
  totalPnl        Decimal          @default(0)
  sharpeRatio     Decimal?
  maxDrawdownHit  Decimal          @default(0)
  // Metadata
  version         Int              @default(1)
  tags            String[]         @default([])
  isPublic        Boolean          @default(false)  // share in marketplace
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastRunAt       DateTime?

  signals         AlgoSignal[]
  executions      AlgoExecution[]
  backtests       AlgoBacktest[]
  logs            AlgoLog[]
  schedules       AlgoSchedule[]

  @@index([accountId, status])
  @@index([type, status])
  @@index([status, lastRunAt])
  @@map("algo_strategies")
}

model AlgoSignal {
  id          String         @id @default(cuid())
  strategyId  String
  strategy    AlgoStrategy   @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  symbol      String
  type        AlgoSignalType
  price       Decimal                              // price at signal generation
  targetPrice Decimal?                             // expected target
  stopLoss    Decimal?
  confidence  Decimal        @default(0)           // 0-100 signal strength
  reason      String?                              // human-readable reason
  indicators  Json?                                // indicator values at signal time
  status      String         @default("PENDING")   // PENDING, EXECUTED, EXPIRED, CANCELLED
  expiresAt   DateTime?
  executedAt  DateTime?
  createdAt   DateTime       @default(now())

  executions  AlgoExecution[]

  @@index([strategyId, status])
  @@index([symbol, createdAt])
  @@index([createdAt])
  @@map("algo_signals")
}

model AlgoExecution {
  id          String               @id @default(cuid())
  strategyId  String
  strategy    AlgoStrategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  signalId    String?
  signal      AlgoSignal?          @relation(fields: [signalId], references: [id])
  symbol      String
  side        TradingOrderSide
  orderType   TradingOrderType     @default(MARKET)
  quantity    Decimal
  price       Decimal                              // intended price
  filledPrice Decimal?                             // actual fill price
  filledQty   Decimal?
  status      AlgoExecutionStatus  @default(PENDING)
  brokerId    String?                              // which broker executed
  brokerOrderId String?                            // external order ID
  slippage    Decimal?                             // actual slippage
  fees        Decimal              @default(0)
  pnl         Decimal?                             // realized P&L for this execution
  error       String?
  metadata    Json?
  createdAt   DateTime             @default(now())
  filledAt    DateTime?

  @@index([strategyId, status])
  @@index([symbol, createdAt])
  @@index([status, createdAt])
  @@map("algo_executions")
}

model AlgoBacktest {
  id            String       @id @default(cuid())
  strategyId    String
  strategy      AlgoStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  // Config
  startDate     DateTime
  endDate       DateTime
  initialCapital Decimal     @default(100000)
  symbols       String[]
  timeframe     AlgoTimeframe
  // Results
  totalTrades   Int          @default(0)
  winningTrades Int          @default(0)
  losingTrades  Int          @default(0)
  winRate       Decimal      @default(0)
  totalPnl      Decimal      @default(0)
  maxDrawdown   Decimal      @default(0)
  sharpeRatio   Decimal?
  sortinoRatio  Decimal?
  profitFactor  Decimal?
  avgWin        Decimal?
  avgLoss       Decimal?
  maxConsecWins Int          @default(0)
  maxConsecLoss Int          @default(0)
  finalCapital  Decimal?
  // Trade log
  trades        Json         @default("[]")        // [{entry,exit,pnl,duration}]
  equityCurve   Json         @default("[]")        // [{date,equity}]
  status        String       @default("RUNNING")   // RUNNING, COMPLETED, FAILED
  error         String?
  duration      Int?                               // seconds to complete
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([strategyId, createdAt])
  @@map("algo_backtests")
}

model AlgoSchedule {
  id          String       @id @default(cuid())
  strategyId  String
  strategy    AlgoStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  name        String
  type        String       @default("CRON")        // CRON, INTERVAL, EVENT
  cron        String?                              // cron expression
  intervalMs  Int?                                 // for INTERVAL type
  eventType   String?                              // PRICE_CROSS, VOLUME_SPIKE, NEWS, MARKET_OPEN
  eventConfig Json?                                // event-specific config
  timezone    String       @default("Asia/Kolkata")
  isActive    Boolean      @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runCount    Int          @default(0)
  maxRuns     Int?                                 // null = unlimited
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive, nextRunAt])
  @@index([strategyId])
  @@map("algo_schedules")
}

model AlgoBroker {
  id          String   @id @default(cuid())
  name        String                               // Zerodha, IBKR, Alpaca, Binance
  slug        String   @unique
  type        String   @default("STOCK")           // STOCK, CRYPTO, FOREX, MULTI
  // Connection
  apiUrl      String
  wsUrl       String?
  authType    String   @default("API_KEY")         // API_KEY, OAUTH, TOKEN
  // Capabilities
  markets     String[] @default([])                // NSE, NYSE, CRYPTO, etc.
  orderTypes  String[] @default(["MARKET", "LIMIT"])
  features    String[] @default([])                // BRACKET, COVER, GTT, ALGO
  // Limits
  rateLimit   Int      @default(10)                // requests per second
  maxOrders   Int      @default(200)               // per day
  // Status
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  // Metadata
  logoUrl     String?
  docsUrl     String?
  country     String   @default("IN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections AlgoBrokerConnection[]

  @@index([isActive, type])
  @@map("algo_brokers")
}

model AlgoBrokerConnection {
  id          String    @id @default(cuid())
  brokerId    String
  broker      AlgoBroker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Credentials (encrypted)
  apiKey      String?
  apiSecret   String?
  accessToken String?
  refreshToken String?
  tokenExpiry DateTime?
  // Status
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  lastSyncAt  DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([brokerId, accountId])
  @@index([accountId, isActive])
  @@map("algo_broker_connections")
}

model AlgoLog {
  id          String       @id @default(cuid())
  strategyId  String
  strategy    AlgoStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  level       String       @default("INFO")        // DEBUG, INFO, WARN, ERROR
  message     String
  data        Json?
  createdAt   DateTime     @default(now())

  @@index([strategyId, createdAt])
  @@index([level, createdAt])
  @@map("algo_logs")
}


// ===================== ADVERTISING / SPONSORED =====================

model AdCampaign {
  id          String   @id @default(cuid())
  sellerId    String?
  productId   String
  bid         Decimal  @default(0) // cost per click
  budget      Decimal  @default(0)
  spent       Decimal  @default(0)
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | EXHAUSTED
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, productId])
  @@index([sellerId])
  @@map("ad_campaigns")
}

// ===================== FULFILLMENT BY PLATFORM (FBA-style) =====================

model FbaEnrollment {
  id        String   @id @default(cuid())
  productId String
  sellerId  String?
  mfcId     String
  units     Int      @default(0)
  status    String   @default("ENROLLED") // ENROLLED | ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([mfcId, status])
  @@map("fba_enrollments")
}
