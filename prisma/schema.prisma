  sharedAt  DateTime @default(now())

  @@index([productId])
  @@map("social_shares")
}

// ===================== DELIVERY SLOTS =====================

model DeliverySlot {
  id           String   @id @default(cuid())
  date         DateTime
  timeFrom     DateTime
  timeTo       DateTime
  maxOrders    Int      @default(100)
  bookedOrders Int      @default(0)
  isActive     Boolean  @default(true)
  fee          Decimal  @default(0)
  createdAt    DateTime @default(now())

  orders       Order[]
  @@index([date, isActive])
  @@map("delivery_slots")
