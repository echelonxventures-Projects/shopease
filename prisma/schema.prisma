model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@map("review_votes")
}

// ===================== PRODUCT Q&A =====================

model ProductQuestion {
