// ===================== PRODUCTS & CATALOG =====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  translations CategoryTranslation[]
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  siteCategories SiteCategory[]
  brandCategories BrandCategory[]
  paymentGateways PaymentGatewayCategory[]

  @@index([slug])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  isActive    Boolean  @default(true)
  ownerId            String?
  registrationStatus String  @default("NONE") // NONE | PENDING | APPROVED | REJECTED
  registeredAt       DateTime?
  products    Product[]
  translations BrandTranslation[]
  brandStories BrandStory[]
  siteBrands   SiteBrand[]
  brandCategories BrandCategory[]
}

model BrandCategory {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([brandId, categoryId])
  @@index([categoryId])
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  shortDesc     String?
  price         Decimal
  comparePrice  Decimal?
  discountType      DiscountType @default(NONE)
  discountValue     Decimal?
  offerStartDate    DateTime?
  offerEndDate      DateTime?
  images        String[]
  thumbnail     String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  sku           String?
  stock         Int       @default(0)
  weight        String?
  dimensions    String?
  hasVariants   Boolean   @default(false)
  specs         Json?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  tags          String[]
  avgRating     Decimal   @default(0)
  reviewCount   Int       @default(0)

  // Global product catalogue fields
  productType               ProductType         @default(PHYSICAL)
  barcodes                  String[]
  hsCode                    String?
  taxCategory               TaxCategory         @default(STANDARD)
  uom                       UOM?
  uomMultiplier             Decimal?
  freightClass              FreightClass?
  trackingType              ProductTrackingType @default(NONE)
  expiryDays                Int?
  minShelfLife              Int?
  isSnappable               Boolean             @default(false)
  digitalUrl                String?
  maxDownloads              Int?
  downloadExpiry            DateTime?
  subscriptionInterval      String?
  subscriptionDuration      Int?
  subscriptionTrialDays     Int?
  bundleItems               Json?
  tierPricing               Json?

  // ═══════════════════════════════════════════════════════════════════════════
  // INTERNATIONAL STANDARD FIELDS (GS1, UNSPSC, ISO, WCO, OECD, FDA, EU)
  // ═══════════════════════════════════════════════════════════════════════════

  // ── Identification & Classification ──────────────────────────────────────
  gtin                      String?   // GS1 Global Trade Item Number (EAN/UPC/ISBN)
  gtin14                    String?   // 14-digit GTIN for case/pallet
  mpn                       String?   // Manufacturer Part Number
  isbn                      String?   // International Standard Book Number
  issn                      String?   // International Standard Serial Number
  upc                       String?   // Universal Product Code
  ean                       String?   // European Article Number
  jan                       String?   // Japanese Article Number
  asin                      String?   // Amazon Standard Identification Number
  unspsc                    String?   // United Nations Standard Products & Services Code
  naicsCode                 String?   // North American Industry Classification
  sitcCode                  String?   // Standard International Trade Classification
  eccnCode                  String?   // Export Control Classification Number
  scheduleBCode             String?   // US Schedule B export code
  taricCode                 String?   // EU TARIC code
  htsCode                   String?   // Harmonized Tariff Schedule (import)
  casNumber                 String?   // Chemical Abstracts Service number
  ndc                       String?   // National Drug Code (pharma)
  atcCode                   String?   // Anatomical Therapeutic Chemical code
  gmdn                      String?   // Global Medical Device Nomenclature
  udiCode                   String?   // Unique Device Identification (medical)
  vinNumber                 String?   // Vehicle Identification Number
  imeiNumber                String?   // International Mobile Equipment Identity
  fccId                     String?   // FCC Registration ID

  // ── Condition & Lifecycle ────────────────────────────────────────────────
  condition                 ProductCondition @default(NEW)
  conditionNote             String?
  manufactureDate           DateTime?
  expiryDate                DateTime?
  bestBeforeDate            DateTime?
  harvestDate               DateTime?
  vintageYear               Int?
  modelYear                 Int?
  firstAvailableDate        DateTime?
  discontinuedDate          DateTime?
  endOfLifeDate             DateTime?
  endOfSupportDate          DateTime?

  // ── Manufacturer & Origin ────────────────────────────────────────────────
  manufacturer              String?
  manufacturerUrl           String?
  countryOfOrigin           String?   // ISO 3166-1 alpha-2
  countryOfManufacture      String?
  regionOfOrigin            String?   // e.g. "Champagne", "Darjeeling"
  assembledIn               String?
  designedIn                String?
  madeInLabel               String?   // "Made in India", "Assembled in USA"
  factoryId                 String?   // Factory/facility identifier
  plantCode                 String?

  // ── Physical Attributes ──────────────────────────────────────────────────
  weightGrams               Decimal?  // Net weight in grams
  grossWeightGrams          Decimal?  // Gross weight including packaging
  tareWeightGrams           Decimal?  // Packaging weight only
  lengthMm                  Decimal?  // Length in millimeters
  widthMm                   Decimal?  // Width in millimeters
  heightMm                  Decimal?  // Height in millimeters
  volumeMl                  Decimal?  // Volume in milliliters
  volumeCbm                 Decimal?  // Volume in cubic meters (shipping)
  diameterMm                Decimal?
  thicknessMm               Decimal?
  netContent                String?   // "500ml", "1kg", "12 pieces"
  netContentValue           Decimal?
  netContentUnit            String?   // ml, g, kg, pieces, etc.
  drainedWeight             Decimal?  // For canned/jarred products
  servingSize               String?
  servingsPerContainer      Int?
  packageType               String?   // bottle, box, blister, sachet, etc.
  packageMaterial           String?   // glass, plastic, cardboard, etc.
  packagingLevels           Int?      // 1=unit, 2=inner, 3=case, 4=pallet
  unitsPerPack              Int?
  packsPerCase              Int?
  casesPerPallet            Int?
  palletTi                  Int?      // Pallet tier (layers)
  palletHi                  Int?      // Pallet high (units per layer)

  // ── Pricing & Trade ──────────────────────────────────────────────────────
  costPrice                 Decimal?  // Landed cost
  wholesalePrice            Decimal?
  tradePrice                Decimal?
  mapPrice                  Decimal?  // Minimum Advertised Price
  msrp                      Decimal?  // Manufacturer's Suggested Retail Price
  dutyCost                  Decimal?
  dutyRate                  Decimal?  // Duty percentage
  vatRate                   Decimal?  // VAT/GST rate override
  exciseDuty                Decimal?
  antiDumpingDuty           Decimal?
  countervailingDuty        Decimal?
