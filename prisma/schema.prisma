// ===================== SERVICES - DIGITAL GOLD =====================

model GoldHolding {
  id        String   @id @default(cuid())
  userId    String
  grams     Float
  buyPrice  Float
  type      String   @default("BUY") // BUY | SELL
  amount    Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("gold_holdings")
}

