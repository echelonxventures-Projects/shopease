  @@map("bundle_deal_items")
}

// ===================== VIDEO REVIEWS =====================

model VideoReview {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  videoUrl  String
  thumbnail String?
  duration  Int?     // seconds
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("video_reviews")
}

// ===================== SELLER MARKETPLACE =====================

model Seller {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  businessName    String
  businessEmail   String
  businessPhone   String
  gstin           String?
  address         String
  city            String
  state           String
  pincode         String
  bankAccount     String?
  bankIfsc        String?
  bankName        String?
  commissionRate  Decimal  @default(10) // percentage
  status          String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED
  rating          Decimal  @default(0)
  totalOrders     Int      @default(0)
  totalRevenue    Decimal  @default(0)
  kycVerified     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        SellerProduct[]
  orders          SellerOrder[]
  payouts         SellerPayout[]
  reviews         SellerReview[]
  rfqResponses    RFQResponse[]
  @@index([status])
  @@map("sellers")
}

model SellerProduct {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  sku         String?
  costPrice   Decimal?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, status])
  @@map("seller_products")
}

model SellerOrder {
  id              String   @id @default(cuid())
  sellerId        String
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal
  commissionAmount Decimal
  status          String   @default("PENDING") // PENDING | SHIPPED | DELIVERED | RETURNED
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([sellerId, orderId])
  @@map("seller_orders")
}

model SellerPayout {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount      Decimal
  commission  Decimal
  netAmount   Decimal
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("PENDING") // PENDING | PROCESSED | PAID | FAILED
  transferId  String?
  transferredAt DateTime?
  createdAt   DateTime @default(now())

  @@index([sellerId, status])
  @@map("seller_payouts")
}

model SellerReview {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@map("seller_reviews")
}

model ReturnRequest {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  reason         String
  status         String   @default("REQUESTED") // REQUESTED | PICKED_UP | IN_TRANSIT | QUALITY_CHECK | REFUNDED | REJECTED
  pickupDate     DateTime?
  pickupAddress  String?
  refundAmount   Decimal?
  refundStatus   String   @default("PENDING") // PENDING | PROCESSED | FAILED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId, status])
  @@index([userId])
  @@map("return_requests")
}

model FCMToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String
  deviceInfo String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, token])
  @@index([userId])
  @@map("fcm_tokens")
}

