generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== LOCATION HIERARCHY =====================

enum LocationType {
  PLANET
  REGION
  COUNTRY
  STATE
  DISTRICT
  VILLAGE
  CITY
  FACILITY
}

model Location {
  id              String        @id @default(cuid())
  name            String
  code            String?       // ISO codes: "IN", "MH", "IN-MH-01", etc.
  type            LocationType
  parentId        String?
  parent          Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Location[]    @relation("LocationHierarchy")
  isActive        Boolean       @default(true)
  isVerified      Boolean       @default(false)
  latitude        Decimal?
  longitude       Decimal?
  translations    LocationTranslation[]
  countryProfile  CountryProfile?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Address lookups
  countryAddrs    Address[]     @relation("AddressCountryLoc")
  stateAddrs      Address[]     @relation("AddressStateLoc")
  districtAddrs   Address[]     @relation("AddressDistrictLoc")
  villageAddrs    Address[]     @relation("AddressVillageLoc")

  // Inventory
  inventories     Inventory[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  inventoryLogs   InventoryLog[]

  // Supplier FKs
  supplierCountries Supplier[]  @relation("SupplierCountry")
  supplierStates    Supplier[]  @relation("SupplierState")
  deliveryZones     DeliveryZone[] @relation("DeliveryZoneFacility")
  mfcLocations      MicroFulfillmentCenter[]
  serialLotTracking SerialLotTracking[]

  @@index([type])
  @@index([parentId])
  @@unique([code])
  @@index([name])
  @@index([type, isActive])
  @@map("locations")
}

model LocationTranslation {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locale     String   // "en", "hi", "de", etc.
  name       String
  code       String?

  @@unique([locationId, locale])
  @@index([locale])
  @@map("location_translations")
}

model CountryProfile {
  id               String   @id @default(cuid())
  locationId       String   @unique
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isoCode          String   @unique // "IN", "US", "DE"
  currency         String   // ISO 4217: "INR", "USD"
  currencySymbol   String   // "₹", "$"
  defaultLocale    String   // BCP 47: "en-IN", "en-US"
  supportedLocales String[]
  taxRate          Decimal  @default(0.18)
  timezone         String   @default("Asia/Kolkata")
  dialCode         String?
  callingCode      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isoCode])
  @@map("country_profiles")
}

// ===================== GLOBALIZATION: REGIONS & LOCALES =====================

model Region {
  id               String   @id @default(cuid())
  code             String   @unique  // ISO 3166-1 alpha-2: "IN", "US", "DE"
  name             String
  currency         String   // ISO 4217: "INR", "USD", "EUR"
  currencySymbol   String   // "₹", "$", "€"
  defaultLocale    String   // BCP 47: "en-IN", "en-US", "de-DE"
  supportedLocales String[]
  taxRate          Decimal  @default(0.18)
  taxInclusive     Boolean  @default(true) // true = price includes tax (India), false = price excludes tax (US)
  isActive         Boolean  @default(true)
  timezone         String   @default("Asia/Kolkata")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prices           ProductRegionPrice[]
  availabilities   ProductRegionAvailability[]
  gatewayRegions   PaymentGatewayRegion[]
  users            User[]
  promos           Promo[]
  orders           Order[]
  voucherTiers     VoucherTier[]
  vouchers         Voucher[]
  giftCards        GiftCard[]
  walletTransactions WalletTransaction[]
  deliveryZones    DeliveryZone[]
  taxCategoryRules TaxCategoryRule[]
  sites            Site[]

  @@index([code])
  @@index([isActive])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String   // "hi", "de", "ja", "zh"
  name        String
  slug        String
  shortDesc   String?
  description String?
  tags        String[]

  @@unique([productId, locale])
  @@index([locale])
}

model ProductRegionPrice {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  currency      String
  price         Decimal
  comparePrice  Decimal?
  discountType  DiscountType @default(NONE)
  discountValue Decimal?

  @@unique([productId, regionId])
  @@index([regionId, currency])
}

model ProductRegionAvailability {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  isAvailable Boolean   @default(true)
  stock       Int       @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  notes       String?

  @@unique([productId, regionId])
  @@index([regionId, isAvailable])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String
  slug       String   @unique
  description String?

  @@unique([categoryId, locale])
  @@index([locale])
}

model BrandTranslation {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale     String
  name       String
  slug       String   @unique
  description String?

  @@unique([brandId, locale])
  @@index([locale])
}

// ===================== CORE USERS & AUTH =====================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String?
  phone           String?
  role            UserRole @default(CUSTOMER)
  roleId          String?
  dynamicRole     Role?    @relation(fields: [roleId], references: [id])
  locale          String?  @default("en")
  regionId        String?
  region          Region?  @relation(fields: [regionId], references: [id])
  siteId          String?
  site            Site?    @relation(fields: [siteId], references: [id])
  avatar          String?
  isBlocked       Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  addresses       Address[]
  wishlist        WishlistItem[]
  reviews         Review[]
  orders          Order[]
  cartItems       CartItem[]
  supportTickets  SupportTicket[] @relation("CustomerTickets")
  assignedTickets SupportTicket[] @relation("AgentTickets")
  auditLogs       AuditLog[]
  notifications   Notification[]
  customLists     CustomList[]
  sentMessages    TicketMessage[]
  wallet          Wallet?
  voucherRedemptions VoucherRedemption[]
  tierBalances    VoucherTierBalance[]
  giftCardTransactions GiftCardTransaction[]
  walletTopUps    WalletTopUp[]
  approvedPOs         PurchaseOrder[]  @relation("PurchaseOrderApprovals")
  approvedReturns     SupplierReturn[] @relation("ReturnApprovals")
  inventoryLogs       InventoryLog[]
  verifiedSuppliers   Supplier[]       @relation("VerifiedSuppliers")
  consents            ConsentRecord[]
  deliveryAgents      DeliveryAgent[]
  subscriptions       CustomerSubscription[]
  loyaltyTransactions LoyaltyTransaction[]
  clippedCoupons      ClippedCoupon[]
  cartSessions        CartSession[]
  primeMembership     PrimeMembership?
  notificationPreference NotificationPreference?
  liveChatSessions    LiveChatSession[]
  liveChatAsAgent     LiveChatSession[] @relation("LiveChatAgent")
  priceDropAlerts     PriceDropAlert[]
  socialShares        SocialShare[]
  seller              Seller?
  sellerReviews       SellerReview[]
  returnRequests      ReturnRequest[]
  fcmTokens           FCMToken[]
  wishlistShareToken  String?  @unique
  apiKeys             ApiKey[]
  aiSegment           String?
  aiPreferences       Json?
  metadata            Json?
  platforms           String[]  @default([]) // Tags: "streaming", "trading", "ecommerce", etc.
  businessProfiles    BusinessUser[]
  giftCardPurchases   GiftCardOrder[]  @relation("GiftCardBuyer")
  siteAdmins          SiteAdmin[]

  @@index([email])
  @@index([role])
  @@index([phone])
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  CUSTOMER_CARE
  SUPPORT
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[]
  routes      String[]   // allowed route prefixes e.g. ["/admin", "/support"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  fullName    String
  phone       String
  street      String
  city        String
  state       String
  zipCode     String
  country     String      @default("India")
  isDefault   Boolean     @default(false)
  type        AddressType @default(HOME)
  countryId   String?
  stateId     String?
  districtId  String?
  villageId   String?
  countryLoc  Location?   @relation("AddressCountryLoc", fields: [countryId], references: [id])
  stateLoc    Location?   @relation("AddressStateLoc", fields: [stateId], references: [id])
  districtLoc Location?   @relation("AddressDistrictLoc", fields: [districtId], references: [id])
  villageLoc  Location?   @relation("AddressVillageLoc", fields: [villageId], references: [id])

  // Delivery location fields (quick commerce)
  latitude      Decimal?    @db.Decimal(9, 6)
  longitude     Decimal?    @db.Decimal(9, 6)
  landmark      String?     @db.VarChar(255)
  addressLabel  String?     @db.VarChar(50)
  deliveryNote  String?     @db.Text

  @@index([userId])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

