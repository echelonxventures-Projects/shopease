  category  String   @default("General")
  question  String
  answer    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
  @@map("faqs")
}

// ===================== BRAND STORIES =====================

model BrandStory {
