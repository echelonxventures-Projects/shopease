generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== LOCATION HIERARCHY =====================

enum LocationType {
  PLANET
  REGION
  COUNTRY
  STATE
  DISTRICT
  VILLAGE
  CITY
  FACILITY
}

model Location {
  id              String        @id @default(cuid())
  name            String
  code            String?       // ISO codes: "IN", "MH", "IN-MH-01", etc.
  type            LocationType
  parentId        String?
  parent          Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Location[]    @relation("LocationHierarchy")
  isActive        Boolean       @default(true)
  isVerified      Boolean       @default(false)
  latitude        Decimal?
  longitude       Decimal?
  translations    LocationTranslation[]
  countryProfile  CountryProfile?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Address lookups
  countryAddrs    Address[]     @relation("AddressCountryLoc")
  stateAddrs      Address[]     @relation("AddressStateLoc")
  districtAddrs   Address[]     @relation("AddressDistrictLoc")
  villageAddrs    Address[]     @relation("AddressVillageLoc")

  // Inventory
  inventories     Inventory[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  inventoryLogs   InventoryLog[]

  // Supplier FKs
  supplierCountries Supplier[]  @relation("SupplierCountry")
  supplierStates    Supplier[]  @relation("SupplierState")
  deliveryZones     DeliveryZone[] @relation("DeliveryZoneFacility")
  mfcLocations      MicroFulfillmentCenter[]
  serialLotTracking SerialLotTracking[]

  @@index([type])
  @@index([parentId])
  @@unique([code])
  @@index([name])
  @@index([type, isActive])
  @@map("locations")
}

model LocationTranslation {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locale     String   // "en", "hi", "de", etc.
  name       String
  code       String?

  @@unique([locationId, locale])
  @@index([locale])
  @@map("location_translations")
}

model CountryProfile {
  id               String   @id @default(cuid())
  locationId       String   @unique
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isoCode          String   @unique // "IN", "US", "DE"
  currency         String   // ISO 4217: "INR", "USD"
  currencySymbol   String   // "₹", "$"
  defaultLocale    String   // BCP 47: "en-IN", "en-US"
  supportedLocales String[]
  taxRate          Decimal  @default(0.18)
  timezone         String   @default("Asia/Kolkata")
  dialCode         String?
  callingCode      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isoCode])
  @@map("country_profiles")
}

// ===================== GLOBALIZATION: REGIONS & LOCALES =====================

model Region {
  id               String   @id @default(cuid())
  code             String   @unique  // ISO 3166-1 alpha-2: "IN", "US", "DE"
  name             String
  currency         String   // ISO 4217: "INR", "USD", "EUR"
  currencySymbol   String   // "₹", "$", "€"
  defaultLocale    String   // BCP 47: "en-IN", "en-US", "de-DE"
  supportedLocales String[]
  taxRate          Decimal  @default(0.18)
  isActive         Boolean  @default(true)
  timezone         String   @default("Asia/Kolkata")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prices           ProductRegionPrice[]
  availabilities   ProductRegionAvailability[]
  gatewayRegions   PaymentGatewayRegion[]
  users            User[]
  promos           Promo[]
  orders           Order[]
  voucherTiers     VoucherTier[]
  vouchers         Voucher[]
  giftCards        GiftCard[]
  walletTransactions WalletTransaction[]
  deliveryZones    DeliveryZone[]
  taxCategoryRules TaxCategoryRule[]

  @@index([code])
  @@index([isActive])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String   // "hi", "de", "ja", "zh"
  name        String
  slug        String
  shortDesc   String?
  description String?
  tags        String[]

  @@unique([productId, locale])
  @@index([locale])
}

model ProductRegionPrice {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  currency      String
  price         Decimal
  comparePrice  Decimal?
  discountType  DiscountType @default(NONE)
  discountValue Decimal?

  @@unique([productId, regionId])
  @@index([regionId, currency])
}

model ProductRegionAvailability {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  isAvailable Boolean   @default(true)
  stock       Int       @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  notes       String?

  @@unique([productId, regionId])
  @@index([regionId, isAvailable])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String
  slug       String   @unique
  description String?

  @@unique([categoryId, locale])
  @@index([locale])
}

model BrandTranslation {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale     String
  name       String
  slug       String   @unique
  description String?

  @@unique([brandId, locale])
  @@index([locale])
}

// ===================== CORE USERS & AUTH =====================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String?
  phone           String?
  role            UserRole @default(CUSTOMER)
  locale          String?  @default("en")
  regionId        String?
  region          Region?  @relation(fields: [regionId], references: [id])
  avatar          String?
  isBlocked       Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  addresses       Address[]
  wishlist        WishlistItem[]
  reviews         Review[]
  orders          Order[]
  cartItems       CartItem[]
  supportTickets  SupportTicket[] @relation("CustomerTickets")
  assignedTickets SupportTicket[] @relation("AgentTickets")
  auditLogs       AuditLog[]
  notifications   Notification[]
  customLists     CustomList[]
  sentMessages    TicketMessage[]
  wallet          Wallet?
  voucherRedemptions VoucherRedemption[]
  tierBalances    VoucherTierBalance[]
  giftCardTransactions GiftCardTransaction[]
  walletTopUps    WalletTopUp[]
  approvedPOs         PurchaseOrder[]  @relation("PurchaseOrderApprovals")
  approvedReturns     SupplierReturn[] @relation("ReturnApprovals")
  inventoryLogs       InventoryLog[]
  verifiedSuppliers   Supplier[]       @relation("VerifiedSuppliers")
  consents            ConsentRecord[]
  deliveryAgents      DeliveryAgent[]
  subscriptions       CustomerSubscription[]
  loyaltyTransactions LoyaltyTransaction[]
  clippedCoupons      ClippedCoupon[]
  cartSessions        CartSession[]
  primeMembership     PrimeMembership?
  notificationPreference NotificationPreference?
  liveChatSessions    LiveChatSession[]
  liveChatAsAgent     LiveChatSession[] @relation("LiveChatAgent")
  priceDropAlerts     PriceDropAlert[]
  socialShares        SocialShare[]
  seller              Seller?
  sellerReviews       SellerReview[]
  returnRequests      ReturnRequest[]
  fcmTokens           FCMToken[]
  wishlistShareToken  String?  @unique
  apiKeys             ApiKey[]
  aiSegment           String?
  aiPreferences       Json?
  businessProfiles    BusinessUser[]
  giftCardPurchases   GiftCardOrder[]  @relation("GiftCardBuyer")

  @@index([email])
  @@index([role])
}

enum UserRole {
  CUSTOMER
  ADMIN
  CUSTOMER_CARE
  SUPPORT
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  fullName    String
  phone       String
  street      String
  city        String
  state       String
  zipCode     String
  country     String      @default("India")
  isDefault   Boolean     @default(false)
  type        AddressType @default(HOME)
  countryId   String?
  stateId     String?
  districtId  String?
  villageId   String?
  countryLoc  Location?   @relation("AddressCountryLoc", fields: [countryId], references: [id])
  stateLoc    Location?   @relation("AddressStateLoc", fields: [stateId], references: [id])
  districtLoc Location?   @relation("AddressDistrictLoc", fields: [districtId], references: [id])
  villageLoc  Location?   @relation("AddressVillageLoc", fields: [villageId], references: [id])

  // Delivery location fields (quick commerce)
  latitude      Decimal?    @db.Decimal(9, 6)
  longitude     Decimal?    @db.Decimal(9, 6)
  landmark      String?     @db.VarChar(255)
  addressLabel  String?     @db.VarChar(50)
  deliveryNote  String?     @db.Text

  @@index([userId])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// ===================== GLOBAL PRODUCT CATALOGUE =====================

enum ProductType {
  PHYSICAL
  DIGITAL
  SUBSCRIPTION
  SERVICE
  BUNDLE
  COMBO
}

enum UOMCategory {
  WEIGHT
  LENGTH
  VOLUME
  AREA
  COUNT
  TIME
  DIGITAL
  FUEL_ENERGY
}

enum UOM {
  GM
  KG
  TON
  MM
  CM
  METER
  INCH
  FT
  ML
  LITER
  SQ_M
  SQ_FT
  PIECE
  DOZEN
  PACK
  SET
  BOX
  BUNDLE
  CAN
  BAG
  ROLL
  SHEET
  KB
  MB
  GB
  TB
  HOUR
  DAY
  MONTH
  YEAR
}

enum FreightClass {
  STANDARD
  OVERSIZED
  FRAGILE
  HAZARDOUS
  PERISHABLE
  REFRIGERATED
}

enum TaxCategory {
  STANDARD
  FOOD
  BOOKS
  PHARMA
  CLOTHING
  LUXURY
  ALCOHOL
  TOBACCO
}

enum ProductTrackingType {
  NONE
  SERIAL
  LOT
}

// ===================== PRODUCTS & CATALOG =====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  translations CategoryTranslation[]
  position    Int       @default(0)
  isActive    Boolean   @default(true)

  @@index([slug])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  isActive    Boolean  @default(true)
  products    Product[]
  translations BrandTranslation[]
  brandStories BrandStory[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  shortDesc     String?
  price         Decimal
  comparePrice  Decimal?
  discountType      DiscountType @default(NONE)
  discountValue     Decimal?
  offerStartDate    DateTime?
  offerEndDate      DateTime?
  images        String[]
  thumbnail     String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  sku           String?
  stock         Int       @default(0)
  weight        String?
  dimensions    String?
  hasVariants   Boolean   @default(false)
  specs         Json?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  tags          String[]
  avgRating     Decimal   @default(0)
  reviewCount   Int       @default(0)

  // Global product catalogue fields
  productType               ProductType         @default(PHYSICAL)
  barcodes                  String[]
  hsCode                    String?
  taxCategory               TaxCategory         @default(STANDARD)
  uom                       UOM?
  uomMultiplier             Decimal?
  freightClass              FreightClass?
  trackingType              ProductTrackingType @default(NONE)
  expiryDays                Int?
  minShelfLife              Int?
  isSnappable               Boolean             @default(false)
  digitalUrl                String?
  maxDownloads              Int?
  downloadExpiry            DateTime?
  subscriptionInterval      String?
  subscriptionDuration      Int?
  subscriptionTrialDays     Int?
  bundleItems               Json?
  tierPricing               Json?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  translations  ProductTranslation[]
  regionPrices  ProductRegionPrice[]
  regionAvailabilities ProductRegionAvailability[]
  optionTypes   ProductOptionType[]
  variants      ProductVariant[]
  inventory     Inventory[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  customListItems CustomListItem[]
  reviews       Review[]
  conversionEvents ConversionEvent[]
  stockMovements StockMovement[]
  inventoryLogs  InventoryLog[]
  productSuppliers ProductSupplier[]
  purchaseOrderItems PurchaseOrderItem[]
  supplierReturnItems SupplierReturnItem[]

  // Global product catalogue relations
  tierPrices          TierPrice[]
  bundleAsProduct     BundleItem[]    @relation("BundleComponents")
  bundleAsBundle      BundleItem[]    @relation("BundleProducts")
  serialLotTracking   SerialLotTracking[]
  subscription        ProductSubscription?
  subscriptions       CustomerSubscription[]
  barcodeRecords      ProductBarcode[]
  giftWithPurchase    GiftWithPurchase[]
  dynamicPriceRule    DynamicPriceRule?
  subscribePromos     SubscribePromo[]
  sellerProducts      SellerProduct[]
  socialShares        SocialShare[]
  sellerOrders        SellerOrder[]
  bundleDealItems     BundleDealItem[]
  priceDropAlerts     PriceDropAlert[]
  dailyDeals          DailyDeal[]
  questions           ProductQuestion[]
  priceHistory        PriceHistory[]
  returnRequests      ReturnRequest[]
  // Master catalog
  masterStatus     String   @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  masterCategory   String?  // electronics, fashion, grocery, etc.
  aiScore             Float?
  aiTags              Json?
  userBehaviors       UserBehavior[]
  pricingPredictions  PricingPrediction[]
  demandForecasts     DemandForecast[]
  supplierListings    SupplierProductListing[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([masterStatus])
  @@index([masterCategory])
}

model ProductOptionType {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  label     String?
  sortOrder Int      @default(0)
  values    ProductOptionValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_option_types")
}

model ProductOptionValue {
  id           String   @id @default(cuid())
  optionTypeId String
  optionType   ProductOptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  value        String
  hexColor     String?
  image        String?
  sortOrder    Int      @default(0)
  variants     VariantOptionValue[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([optionTypeId, value])
  @@index([optionTypeId])
  @@map("product_option_values")
}

model ProductVariant {
  id            String     @id @default(cuid())
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?
  isDefault     Boolean    @default(false)
  price         Decimal
  comparePrice  Decimal?
  discountType  DiscountType @default(NONE)
  discountValue Decimal?
  stock         Int        @default(0)
  weight        String?
  images        String[]
  isActive      Boolean    @default(true)
  barcodes      String[]
  hsCode        String?
  trackingType  ProductTrackingType @default(NONE)
  expiryDays    Int?
  options       VariantOptionValue[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([productId, sku])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model VariantOptionValue {
  id            String             @id @default(cuid())
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model Inventory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantity   Int      @default(0)
  lowStock   Int      @default(5)
  avgCost    Decimal  @default(0)
  updatedAt  DateTime @default(now())

  inventoryLogs InventoryLog[]

  @@unique([productId, supplierId, locationId])
  @@index([productId])
  @@index([supplierId])
  @@index([locationId])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type          String
  quantity      Int
  reference     String?
  referenceType String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ===================== SUPPLIERS =====================

model Supplier {
  id                    String                      @id @default(cuid())
  name                  String
  code                  String                      @unique
  uniqueId              String?                     @unique @default(cuid()) @map("supplierUniqueId")
  contactPerson         String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  zipCode               String?
  gstin                 String?
  taxId                 String?
  paymentTerms          String?
  notes                 String?
  isActive              Boolean                     @default(true)

  // Country linkage
  countryId             String?
  countryLoc            Location?                   @relation("SupplierCountry", fields: [countryId], references: [id], onDelete: SetNull)
  stateId               String?
  stateLoc              Location?                   @relation("SupplierState", fields: [stateId], references: [id], onDelete: SetNull)

  // ID verification
  idType                SupplierIdType              @default(TAX_ID)
  verificationStatus    SupplierVerificationStatus  @default(PENDING)
  verifiedById          String?
  verifiedBy            User?                       @relation("VerifiedSuppliers", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  verificationNotes     String?

  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  inventoryItems        Inventory[]
  purchaseOrders        PurchaseOrder[]
  stockMovements        StockMovement[]
  productSuppliers      ProductSupplier[]
  supplierListings      SupplierProductListing[]
  returns               SupplierReturn[]
  inventoryLogs         InventoryLog[]
  serialLotTracking     SerialLotTracking[]

  @@index([code])
  @@index([isActive])
  @@index([uniqueId])
  @@index([verificationStatus])
  @@map("suppliers")
}

enum SupplierIdType {
  GSTIN         // India: Goods & Services Tax ID (15 chars)
  PAN           // India: Permanent Account Number (10 chars)
  EIN           // US: Employer Identification Number (XX-XXXXXXX)
  VAT           // EU/UK: Value Added Tax Number
  ABN           // Australia: Australian Business Number (11 digits)
  SST           // Malaysia/Indonesia: Sales & Service Tax
  BUSINESS_REG  // General: Business Registration Number
  TAX_ID        // Generic: Tax ID
  OTHER         // Custom: other ID type
}

enum SupplierVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model ProductSupplier {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku  String?
  costPrice    Decimal?
  leadTimeDays Int?
  isPreferred  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// ===================== PRODUCT MASTER CATALOG & SUPPLIER LISTING =====================

model SupplierProductListing {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  listingSku      String?
  listingPrice    Decimal  // supplier's selling price to customers
  comparePrice    Decimal? // MRP / original price for discount display
  quantity        Int      @default(0)
  status          String   @default("DRAFT") // DRAFT, ACTIVE, INACTIVE, OUT_OF_STOCK, REJECTED
  isFeatured      Boolean  @default(false)
  shippingWeight  Decimal? // kg
  shippingLength  Decimal? // cm
  shippingWidth   Decimal? // cm
  shippingHeight  Decimal? // cm
  tags            String[]
  extraImages     String[]
  description     String?  // supplier-specific product description
  keywords        String[]
  enabledAt       DateTime?
  disabledAt      DateTime?
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([supplierId, status])
  @@index([productId, status])
  @@index([status])
  @@map("supplier_listings")
}

// ===================== PURCHASE ORDERS =====================

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  poNumber        String               @unique
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  locationId      String?
  location        Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status          PurchaseOrderStatus  @default(DRAFT)
  items           PurchaseOrderItem[]
  returns         SupplierReturn[]
  subtotal        Decimal              @default(0)
  tax             Decimal              @default(0)
  total           Decimal              @default(0)
  expectedDate    DateTime?
  receivedDate    DateTime?
  notes           String?
  approvedById    String?
  approvedBy      User?          @relation("PurchaseOrderApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  approvalNotes   String?
  sentDate        DateTime?
  createdBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  sentQuantity     Int      @default(0)
  receivedQuantity Int      @default(0)
  returnQuantity   Int      @default(0)
  unitPrice        Decimal
  subtotal         Decimal
  notes            String?

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ===================== INVENTORY LOGS =====================

enum InventoryLogType {
  PURCHASE_RECEIPT
  SALE_DEDUCTION
  RETURN
  ADJUSTMENT
  TRANSFER
  INITIAL
}

model InventoryLog {
  id              String           @id @default(cuid())
  inventoryId     String
  inventory       Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type            InventoryLogType
  quantity        Int              // delta (positive = added, negative = removed)
  beforeQuantity  Int
  afterQuantity   Int
  referenceId     String?
  referenceType   String?          // "PURCHASE_ORDER", "RETURN", "ORDER_FULFILLMENT", "ADJUSTMENT", etc.
  reference       String?          // human-readable: PO number, return number, etc.
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([inventoryId])
  @@index([productId])
  @@index([supplierId])
  @@index([locationId])
  @@index([type])
  @@index([referenceId, referenceType])
  @@index([createdAt])
  @@index([userId])
  @@map("inventory_logs")
}

// Add InventoryLog relation to Inventory
// (handled automatically by the inventoryId relation field above)

// ===================== SUPPLIER RETURNS =====================

enum ReturnStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SHIPPED
  COMPLETED
  CANCELLED
}

model SupplierReturn {
  id                    String        @id @default(cuid())
  returnNumber          String        @unique  // "RET-XXXXXX"
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId            String
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  status                ReturnStatus  @default(DRAFT)
  items                 SupplierReturnItem[]
  reason                String?
  approvedById          String?
  approvedBy            User?         @relation("ReturnApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  approvalNotes         String?
  shippedDate           DateTime?
  receivedBySupplierDate DateTime?
  createdBy             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([returnNumber])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id               String          @id @default(cuid())
  supplierReturnId String
  supplierReturn   SupplierReturn  @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Decimal
  subtotal         Decimal
  notes            String?

  @@index([supplierReturnId])
  @@index([productId])
  @@map("supplier_return_items")
}

// ===================== CART =====================

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
}

// ===================== ORDERS =====================

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  items           Json
  subtotal        Decimal
  tax             Decimal       @default(0)
  shippingCost    Decimal       @default(0)
  discount        Decimal       @default(0)
  total           Decimal
  shippingAddress Json
  paymentMethod   String?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntent   String?
  trackingCode    String?
  notes           String?
  couponCode      String?
  orderNotes      String?        // Customer order notes/instructions
  isGift          Boolean        @default(false)
  giftMessage     String?
  giftWrapFee     Decimal        @default(0)
  deliverySlotId  String?
  deliverySlot    DeliverySlot?  @relation(fields: [deliverySlotId], references: [id])
  isExpress       Boolean        @default(false)
  expressFee      Decimal        @default(0)
  codFee          Decimal        @default(0)
  isGuestOrder    Boolean        @default(false)
  guestEmail      String?
  shareToken      String?        @unique
  regionId        String?
  region          Region?       @relation(fields: [regionId], references: [id])
  currency        String        @default("INR")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments        Payment[]
  transactions    PaymentTransaction[]
  statusHistory   OrderStatusHistory[]
  refunds         Refund[]
  deliveryAssignment DeliveryAssignment?
  sellerOrders    SellerOrder[]
  bnplOrder       BNPLOrder?
  splitPayment    SplitPayment?
  returnRequests  ReturnRequest[]
  b2bOrder        B2BOrder?

  @@index([userId, status])
  @@index([orderNumber])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  amount         Decimal
  method         String
  status         PaymentStatus  @default(PENDING)
  transactionId  String?
  metadata       Json?
  createdAt      DateTime       @default(now())
}

model Refund {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Decimal
  reason    String
  status    RefundStatus  @default(PENDING)
  adminNote String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// ===================== REVIEWS =====================

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  images      String[]
  isVerified  Boolean  @default(false)
  helpfulVotes    Int      @default(0)
