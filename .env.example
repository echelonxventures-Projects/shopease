# ============================================================================
#  Hyper-Commerce — Environment Configuration
#
#  SELF-HOSTING: To launch on your own domain you only MUST set:
#    1. APP_DOMAIN block below (NEXT_PUBLIC_APP_URL + NEXTAUTH_URL)
#    2. A database password (DB_PASSWORD)
#    3. The three generated secrets (NEXTAUTH_SECRET + 2 encryption keys)
#  Everything else has safe defaults or is optional.
#
#  Generate secrets with:
#    NEXTAUTH_SECRET:            openssl rand -base64 32
#    *_ENCRYPTION_KEY (64 hex):  openssl rand -hex 32
# ============================================================================

# ---- DOMAIN (the only domain config you need) ------------------------------
# Public URL of your deployment. Drives auth callbacks, CORS allowed origins,
# email links, invoice URLs and brand host. Use https in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ---- DATABASE --------------------------------------------------------------
# For local/dev. In docker-compose the host is "db" (handled automatically).
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="ecommerce"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ---- SECRETS (generate fresh values — never reuse the examples) ------------
NEXTAUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_32"
VOUCHER_CODE_ENCRYPTION_KEY="CHANGE_ME_run_openssl_rand_hex_32"
PII_ENCRYPTION_KEY="CHANGE_ME_run_openssl_rand_hex_32_different"

# ---- BRANDING (optional — defaults derive from your domain) ----------------
NEXT_PUBLIC_APP_NAME="Commerce"
# EMAIL_FROM="Commerce <noreply@your-domain.com>"
# SUPPORT_EMAIL="support@your-domain.com"
# COMPANY_NAME="Your Company Ltd."
# COMPANY_EMAIL="billing@your-domain.com"
# COMPANY_WEBSITE="your-domain.com"
# COMPANY_ADDRESS=""
# COMPANY_PHONE=""

# ---- PAYMENTS (optional — enable a gateway by providing its keys) ----------
# Razorpay (primary; India). Test keys (rzp_test_*) are rejected in production
# unless ALLOW_TEST_KEYS=true (use for local/staging sandbox testing only).
ALLOW_TEST_KEYS=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Stripe (international). Activates real charges/refunds/webhooks when set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- PLUGGABLE PROVIDERS (optional — sensible in-process defaults) ---------
# Set REDIS_URL to activate distributed cache + background job queue (BullMQ).
# In docker-compose.prod.yml this defaults to redis://redis:6379.
REDIS_URL=""
# Distributed rate limiting in the Edge runtime needs an HTTP Redis (Upstash, or
# a self-hosted serverless-redis-http proxy in front of REDIS_URL). Without it,
# rate limiting is per-instance in-memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Search: "postgres" (default), "meilisearch", or "typesense"
# SEARCH_MEILISEARCH_URL=""
# SEARCH_MEILISEARCH_KEY=""
# SEARCH_TYPESENSE_URL=""

# ---- UPLOADS ---------------------------------------------------------------
# "local" (default, public/uploads) or "s3" (AWS S3 / Cloudflare R2 / MinIO).
UPLOAD_PROVIDER="local"
# Required when UPLOAD_PROVIDER=s3:
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: S3_ENDPOINT (R2/MinIO), S3_PUBLIC_URL (CDN base for returned URLs)
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# ---- EMAIL/SMS (optional — transactional messaging) ------------------------
RESEND_API_KEY=""
SENDGRID_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# ---- OBSERVABILITY & CRON (optional) ---------------------------------------
SENTRY_DSN=""
CRON_SECRET=""

# ---- DEPLOYMENT (docker-compose.prod.yml) ----------------------------------
# Domain Caddy serves with auto-HTTPS (e.g. shop.example.com).
APP_DOMAIN=""
# Set true on first boot to load demo data; allow destructive db push with DB_ACCEPT_DATA_LOSS.
SEED_ON_START="false"

# ── Data Provider API Keys (Free Tier) ───────────────────────────────────────
# Trading: Market Data
FINNHUB_API_KEY=           # https://finnhub.io/register (free: 60 req/min)
ALPHA_VANTAGE_API_KEY=     # https://www.alphavantage.co/support/#api-key (free: 5 req/min)
# CoinGecko: No API key needed for basic tier
# Yahoo Finance: No API key needed (unofficial)

# Streaming: Content Metadata
TMDB_API_KEY=              # https://www.themoviedb.org/settings/api (free: 40 req/10s)
OMDB_API_KEY=              # https://www.omdbapi.com/apikey.aspx (free: 1000 req/day)
